<?xml version="1.0" encoding="utf-8"?>
<!--
  Kubuno mobile home screen, written in the SHARED Kubuno view vocabulary (the same controls the web and desktop
  designers know), so it renders on every surface. A screen's root is an ordinary container (Panel) — not a
  UserControl: a UserControl is a reusable composite control (.kbcontrol) used as an element of other views.
  Colours are literal brand colours here; a themed screen would use tokens (Surface1, Primary, TextPrimary, ...).
-->
<Panel xmlns="https://kubuno.com/views" xmlns:x="https://kubuno.com/views/x"
       BackColor="#1a162e" Padding="24, 120, 24, 24">
  <Stack Dock="Top" BackColor="#ffffff" CornerRadius="28" Elevation="Lg"
         Padding="28, 36, 28, 36" Gap="18" CrossAlign="Center">
    <Panel BackColor="#6e59f0" CornerRadius="24" Width="104" Height="104"/>
    <Label Text="Kubuno" Role="Display" FontWeight="SemiBold" ForeColor="#1a162e"/>
    <Label Text="kbview · Rust · vello" Role="Body" ForeColor="#6e59f0"/>
    <Button Text="Ouvrir Drive" Variant="Primary" Size="Lg"/>
  </Stack>
</Panel>
