<!-- GroupBox: a settings section - its title, help line and content. -->
<Stack xmlns="https://kubuno.com/views" xmlns:x="https://kubuno.com/views/x" Gap="0">
  <GroupBox Title="Notifications" Description="Choose how Kubuno tells you about new activity.">
    <Stack Gap="12">
      <Switch Label="Desktop notifications" On="true"/>
      <Switch Label="E-mail summary"/>
    </Stack>
  </GroupBox>
  <GroupBox Title="Without a description">
    <Label Text="The content follows the title." ForeColor="TextSecondary"/>
  </GroupBox>
</Stack>
