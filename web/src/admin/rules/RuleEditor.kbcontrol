<!-- RuleEditor — converted from RuleEditor.tsx by @kubuno/views-migrate (partial: see the TODO comments and the report). -->
<UserControl x:Props="Props">
  <Panel Class="contents">
    <Label HtmlTag="Div"
           Text="{Res common.loading}"
           TextAlign="TopCenter"
           Overflow="Wrap"
           ForeColor="TextTertiary"
           InheritFontSize="true"
           Visible="{Binding show_case_1}"
           Class="py-10"/>
    <Callout Variant="Danger" Body="{Res admin.rl_catalog_error}" Visible="{Binding show_case_2}"/>
    <Panel Visible="{Binding show_main}" Class="min-w-0">
      <!-- TODO(views-migrate): elements held in an expression -->
      <ReactHost Component="{Binding Fragment}" Props="{Binding content_header}"/>
      <Panel Visible="{Binding readOnly}" Class="mb-4">
        <Callout Title="{Res admin.rl_readonly_title}" Body="{Res admin.rl_readonly_body}"/>
      </Panel>
      <Panel Visible="{Binding show_error}" Class="mb-4">
        <Callout Variant="Danger" Title="{Res admin.rl_save_failed}" Body="{Binding error}"/>
      </Panel>
      <Panel Visible="{Binding show_leaf_problems}" Class="mb-4">
        <!-- TODO(views-migrate): <Callout> with element children -->
        <ReactHost Component="{Binding Part1}" Props="{Binding part1_props}"/>
      </Panel>
      <Panel Class="grid min-w-0 gap-5 lg:grid-cols-[minmax(0,1fr)_22rem]">
        <Panel Class="min-w-0">
          <!-- TODO(views-migrate): <Stepper> steps: no .kbview property -->
          <ReactHost Component="{Binding Part2}" Props="{Binding part2_props}" Visible="{Binding isNew}"/>
          <!-- TODO(views-migrate): <Tabs> tabs: no .kbview property -->
          <ReactHost Component="{Binding Part3}" Props="{Binding part3_props}" Visible="{Binding show_not_is_new}"/>
          <Panel Visible="{Binding show_not_is_new}" Class="pt-4">
            <!-- TODO(views-migrate): elements held in an expression -->
            <ReactHost Component="{Binding Fragment}" Props="{Binding content_panes_pane}"/>
          </Panel>
          <Stack Direction="LeftToRight" CrossAlign="Center" WrapContents="true" Visible="{Binding isNew}" Class="mt-5">
            <Button Variant="Secondary"
                    Size="Sm"
                    Enabled="{Binding enabled_unless_step_index}"
                    Text="{Res admin.rl_step_prev}"
                    OnClick="button_click"/>
            <Button Variant="Secondary"
                    Size="Sm"
                    Text="{Res admin.rl_step_next}"
                    Visible="{Binding show_step_index_wizard_steps}"
                    OnClick="button_click2"/>
            <Button Size="Sm"
                    IconSize="14"
                    Icon="Check"
                    Enabled="{Binding enabled_unless_can_save}"
                    Loading="{Binding busy}"
                    Text="{Res admin.rl_create}"
                    Visible="{Binding show_not_step_index_wizard_steps}"
                    OnClick="save"/>
          </Stack>
        </Panel>
        <RuleSummaryPanel Input="{Binding ruleSummaryInput}" Tree="{Binding tree}" Ctx="{Binding summaryCtx}" Preview="{Binding preview}" Flat="{Binding isMobile}"/>
      </Panel>
      <Panel BackColor="Surface1" Visible="{Binding show_is_mobile_pane_conditions}" Class="mt-4 rounded-xl border border-border p-4">
        <RuleSentence Input="{Binding ruleSentenceInput}" Tree="{Binding tree}" Ctx="{Binding summaryCtx}"/>
      </Panel>
    </Panel>
  </Panel>
</UserControl>
