<!-- ActionsEditor — converted from ActionsEditor.tsx by @kubuno/views-migrate (partial: see the TODO comments and the report). -->
<UserControl x:Props="Props">
  <Panel Class="min-w-0">
    <Label Text="{Res admin.rl_actions_empty}"
           Overflow="Wrap"
           ForeColor="TextSecondary"
           InheritFontSize="true"
           Visible="{Binding show_value}"
           Class="mb-3 [font-size:var(--kb-text-meta)]"/>
    <Stack Gap="12">
      <Repeater ItemKey="key" ItemsSource="{Binding rows_value}">
        <Panel BackColor="Surface" Class="rounded-lg border border-border p-3">
          <Stack Direction="LeftToRight" CrossAlign="Center" WrapContents="true" Class="min-w-0">
            <Label HtmlTag="Span" Text="{Binding span_text}" Overflow="Wrap" ForeColor="TextPrimary" InheritFontSize="true"/>
            <Badge Size="Sm" Text="{Binding badge_text}"/>
            <!-- TODO(views-migrate): <Badge> with element children -->
            <ReactHost Component="{Binding Part1}" Props="{Binding part1_props}" Visible="{Binding show_def_is_reversible}"/>
            <!-- TODO(views-migrate): <Badge> with element children -->
            <ReactHost Component="{Binding Part2}" Props="{Binding part1_props}" Visible="{Binding show_not_def_is_reversible}"/>
            <Badge Variant="Neutral" Size="Sm" Text="{Res admin.rl_action_blocking}" Visible="{Binding show_def_is_blocking}"/>
            <Badge Variant="Danger" Size="Sm" Text="{Res admin.rl_action_orphan}" Visible="{Binding show_def_is_orphan}"/>
            <Button Variant="Ghost"
                    Size="Sm"
                    AccessibleName="{Res admin.rl_action_remove}"
                    IconSize="14"
                    Icon="Trash2"
                    Visible="{Binding show_disabled}"
                    Class="ms-auto"
                    OnClick="button_click"/>
          </Stack>
          <Label Text="{Binding p_text}"
                 Overflow="Wrap"
                 ForeColor="TextSecondary"
                 InheritFontSize="true"
                 Visible="{Binding show_def_description}"
                 Class="mt-1 [font-size:var(--kb-text-meta)]"/>
          <Stack Gap="10" Visible="{Binding show_schema}" Class="mt-3 border-t border-border pt-3">
            <!-- TODO(views-migrate): a list inside a list (nested Repeater) -->
            <ReactHost Component="{Binding Part3}" Props="{Binding part3_props}"/>
          </Stack>
        </Panel>
      </Repeater>
    </Stack>
    <Stack Direction="LeftToRight" Gap="12" CrossAlign="Center" WrapContents="true" Visible="{Binding show_disabled}" Class="mt-3">
      <Button Variant="Secondary"
              Size="Sm"
              IconSize="14"
              Icon="Plus"
              Enabled="{Binding enabled_unless_full_available}"
              Text="{Res admin.rl_action_add}"
              OnClick="button_click2"/>
      <Label HtmlTag="Span"
             Text="{Res admin.rl_actions_counter, Used={Binding props.value.length}, Max={Binding props.maxActions}}"
             Overflow="Wrap"
             ForeColor="TextTertiary"
             InheritFontSize="true"
             Class="[font-size:var(--kb-text-meta)]"/>
    </Stack>
    <!-- TODO(views-migrate): <ContextMenu> pos, onClose: no .kbview property -->
    <ReactHost Component="{Binding Part4}" Props="{Binding part4_props}" Visible="{Binding show_menu_pos}"/>
  </Panel>
</UserControl>
