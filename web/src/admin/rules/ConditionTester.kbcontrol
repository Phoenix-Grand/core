<!-- ConditionTester — converted from ConditionTester.tsx by @kubuno/views-migrate (partial: see the TODO comments and the report). -->
<UserControl x:Props="Props">
  <Panel Class="min-w-0">
    <Label Text="{Res admin.rl_test_help}"
           Overflow="Wrap"
           ForeColor="TextSecondary"
           InheritFontSize="true"
           Class="mb-2 [font-size:var(--kb-text-meta)]"/>
    <!-- TODO(views-migrate): <TextArea> rows, spellCheck: no .kbview property -->
    <ReactHost Component="{Binding Part1}" Props="{Binding part1_props}"/>
    <Stack Direction="LeftToRight" CrossAlign="Center" WrapContents="true" Class="mt-2">
      <Button Variant="Secondary" Size="Sm" IconSize="14" Icon="Play" Text="{Res admin.rl_test_run}" OnClick="run"/>
      <Button Variant="Ghost" Size="Sm" IconSize="14" Icon="Wand2" Text="{Res admin.rl_test_prefill}" OnClick="button_click"/>
      <Button Variant="Ghost"
              Size="Sm"
              IconSize="14"
              Icon="RotateCcw"
              Text="{Res admin.rl_test_clear}"
              Visible="{Binding ran}"
              OnClick="clear"/>
    </Stack>
    <Panel Visible="{Binding show_error}" Class="mt-2">
      <Callout Variant="Danger" Body="{Binding error}"/>
    </Panel>
    <Panel Visible="{Binding show_ran_error}" Class="mt-2">
      <Callout Variant="{Binding variant}" Body="{Binding callout_text}"/>
    </Panel>
  </Panel>
</UserControl>
