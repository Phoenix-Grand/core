<!-- RuleSummaryPanel - converted from RuleSummaryPanel.tsx by @kubuno/views-migrate (partial: see the TODO comments and the report). -->
<UserControl x:Props="Props">
  <Panel HtmlTag="Aside" AccessibleName="{Res admin.rl_summary_title}" Class="{Binding aside_class}">
    <Panel BackColor="Surface1" Class="rounded-xl border border-border p-4">
      <Stack Direction="LeftToRight" CrossAlign="Center" Class="mb-2">
        <Icon Name="Info" Size="15" Class="text-text-secondary"/>
        <Label HtmlTag="H3" Text="{Res admin.rl_summary_title}" Overflow="Wrap" ForeColor="TextPrimary" InheritFontSize="true"/>
        <Badge Variant="{Binding variant}" Size="Sm" Text="{Binding badge_text}" Class="ms-auto"/>
      </Stack>
      <RuleSentence Input="{Binding props.input}" Tree="{Binding props.tree}" Ctx="{Binding props.ctx}"/>
      <Panel Visible="{Binding show_input_mode_simulate}" Class="mt-3">
        <!-- TODO(views-migrate): <Callout> icon: a value the property converts (null-when-false) -->
        <ReactHost Component="{Binding Part1}" Props="{Binding part1_props}"/>
      </Panel>
      <Panel Visible="{Binding show_input_mode_enforce}" Class="mt-3">
        <Callout Variant="Warning" Title="{Res admin.rl_enforce_banner_title}" Body="{Res admin.rl_enforce_banner_body}"/>
      </Panel>
      <Panel HtmlTag="Ul" ForeColor="TextSecondary" Class="mt-3 flex flex-col gap-1 [font-size:var(--kb-text-meta)]">
        <Label HtmlTag="Li" Text="{Binding li_text}" Overflow="Wrap" InheritFontSize="true"/>
        <Label HtmlTag="Li" Text="{Binding li_text2}" Overflow="Wrap" InheritFontSize="true"/>
        <Label HtmlTag="Li" Text="{Binding li_text3}" Overflow="Wrap" InheritFontSize="true"/>
      </Panel>
      <Panel ForeColor="TextSecondary"
             Visible="{Binding show_preview}"
             Class="mt-3 flex items-start gap-2 border-t border-border pt-3 [font-size:var(--kb-text-meta)]">
        <Icon Name="Users" Size="14" Class="mt-0.5 shrink-0"/>
        <Label HtmlTag="Span" Text="{Binding span_text}" Overflow="Wrap" InheritFontSize="true"/>
      </Panel>
    </Panel>
  </Panel>
</UserControl>
