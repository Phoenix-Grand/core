<!-- ScopeEditor — converted from ScopeEditor.tsx by @kubuno/views-migrate (partial: see the TODO comments and the report). -->
<UserControl x:Props="Props">
  <Stack Gap="20" Class="min-w-0">
    <Callout Variant="Warning" Body="{Res admin.rl_scope_directory_denied}" Visible="{Binding props.dir.denied}"/>
    <Callout Body="{Res admin.rl_scope_everyone_note}" Visible="{Binding show_value_include}"/>
    <!-- TODO(views-migrate): <Bucket> is no .kbview element (a local or dynamic component) -->
    <ReactHost Component="{Binding Part1}" Props="{Binding part1_props}"/>
    <!-- TODO(views-migrate): <Bucket> is no .kbview element (a local or dynamic component) -->
    <ReactHost Component="{Binding Part2}" Props="{Binding part2_props}"/>
    <Label Text="{Binding p_text}" Overflow="Wrap" ForeColor="TextTertiary" InheritFontSize="true" Class="[font-size:var(--kb-text-meta)]"/>
  </Stack>
</UserControl>
