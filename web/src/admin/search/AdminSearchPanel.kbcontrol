<!-- AdminSearchPanel — converted from AdminSearchPanel.tsx by @kubuno/views-migrate (partial: see the TODO comments and the report). -->
<UserControl x:Props="PanelProps">
  <Panel Class="contents">
    <!-- TODO(views-migrate): <ul id>: attribute(s) without a .kbview property -->
    <ReactHost Component="{Binding Part1}" Props="{Binding part1_props}" Visible="{Binding show_case_1}"/>
    <!-- TODO(views-migrate): <ul id>: attribute(s) without a .kbview property -->
    <ReactHost Component="{Binding Part2}" Props="{Binding part2_props}" Visible="{Binding show_case_2}"/>
    <Panel Visible="{Binding show_case_3}" Class="px-2 py-1">
      <EmptyState Compact="true"
                  Variant="NoResults"
                  IconSize="22"
                  Icon="SearchX"
                  Title="{Res admin.search_none_title, Q={Binding search_none_title_q}}"
                  Description="{Binding description}"/>
      <Panel HtmlTag="Ul" AccessibleName="{Res admin.search_cat_suggested}" Visible="{Binding show_near_misses}" Class="pb-2">
        <!-- TODO(views-migrate): <Heading> is no .kbview element (a local or dynamic component) -->
        <ReactHost Component="{Binding Heading}" Props="{Binding heading_props}"/>
        <Repeater ItemKey="key" ItemsSource="{Binding rows_near_misses}">
          <!-- TODO(views-migrate): <ResultRow> is no .kbview element (./ResultRow#ResultRow) -->
          <ReactHost Component="{Binding ResultRow}" Props="{Binding result_row_props}"/>
        </Repeater>
      </Panel>
    </Panel>
    <!-- TODO(views-migrate): <ul id>: attribute(s) without a .kbview property -->
    <ReactHost Component="{Binding Part3}" Props="{Binding part3_props}" Visible="{Binding show_main}"/>
  </Panel>
</UserControl>
