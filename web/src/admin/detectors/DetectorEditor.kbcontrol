<!-- DetectorEditor - converted from DetectorEditor.tsx by @kubuno/views-migrate (partial: see the TODO comments and the report). -->
<UserControl x:Props="Props">
  <Panel Class="min-w-0">
    <Stack Direction="LeftToRight" CrossAlign="Center" WrapContents="true" Visible="{Binding show_id}">
      <Button Variant="Ghost" Size="Sm" IconSize="14" Icon="ArrowLeft" Text="{Res admin.det_back}" OnClick="button_click"/>
    </Stack>
    <Label HtmlTag="H1"
           Text="{Binding h1_text}"
           Overflow="Wrap"
           ForeColor="TextPrimary"
           InheritFontSize="true"
           Class="mt-2 min-w-0 [font-size:var(--kb-text-page)]"/>
    <Label Text="{Res admin.det_loading}"
           Overflow="Wrap"
           ForeColor="TextSecondary"
           InheritFontSize="true"
           Visible="{Binding show_is_loading_id}"
           Class="mt-2 [font-size:var(--kb-text-body)]"/>
    <Panel Visible="{Binding show_error}" Class="mt-3">
      <Callout Variant="Danger" Title="{Res admin.det_save_failed}" Body="{Binding error}"/>
    </Panel>
    <Panel Visible="{Binding show_detector_is_builtin}" Class="mt-3">
      <Callout Title="{Res admin.det_builtin_title}" Body="{Res admin.det_builtin_body}"/>
    </Panel>
    <Panel Visible="{Binding show_used_by}" Class="mt-3">
      <Callout Title="{Res admin.det_used_by_title, Count={Binding usedBy.length}}" Body="{Binding callout_text}"/>
    </Panel>
    <Panel Class="mt-4 grid min-w-0 gap-4 lg:grid-cols-2">
      <Card Title="{Res admin.det_block_identity}">
        <Panel Class="contents">
          <Panel Class="grid gap-3 sm:grid-cols-2">
            <TextField Label="{Res admin.det_field_label}"
                       Text="{Binding form.label}"
                       Enabled="{Binding enabled_unless_can_manage}"
                       OnTextChanged="text_field_text_changed"/>
            <TextField Label="{Res admin.det_field_key}"
                       Text="{Binding form.key}"
                       Enabled="{Binding enabled_unless_can_manage_detector_is}"
                       Hint="{Res admin.det_field_key_hint}"
                       OnTextChanged="text_field_text_changed2"/>
          </Panel>
          <Panel Class="mt-3">
            <TextField Label="{Res admin.det_field_description}"
                       Text="{Binding form.description}"
                       Enabled="{Binding enabled_unless_can_manage}"
                       OnTextChanged="text_field_text_changed3"/>
          </Panel>
          <Panel Class="mt-3 max-w-xs">
            <Label HtmlTag="Span"
                   Text="{Res admin.det_field_category}"
                   Overflow="Wrap"
                   ForeColor="TextSecondary"
                   InheritFontSize="true"
                   Class="block [font-size:var(--kb-text-meta)]"/>
            <Panel Class="mt-1">
              <ComboBox HostStrings="true"
                        SelectedValue="{Binding form.category}"
                        ItemsSource="{Binding categoryOptions}"
                        Enabled="{Binding enabled_unless_can_manage}"
                        AccessibleName="{Res admin.det_field_category}"
                        OnSelectedValueChanged="combo_box_selected_value_changed"/>
            </Panel>
          </Panel>
          <Panel Class="mt-4">
            <Switch Label="{Res admin.det_field_enabled}"
                    Description="{Res admin.det_field_enabled_hint}"
                    On="{Binding form.is_enabled}"
                    Enabled="{Binding enabled_unless_can_manage}"
                    OnCheckedChanged="switch_checked_changed"/>
          </Panel>
        </Panel>
      </Card>
      <Card Title="{Res admin.det_block_shape}">
        <Panel Class="contents">
          <Label HtmlTag="Span"
                 Text="{Res admin.det_field_kind}"
                 Overflow="Wrap"
                 ForeColor="TextSecondary"
                 InheritFontSize="true"
                 Class="block [font-size:var(--kb-text-meta)]"/>
          <Panel Class="mt-1 max-w-xs">
            <ComboBox HostStrings="true"
                      SelectedValue="{Binding form.kind}"
                      ItemsSource="{Binding kindOptions}"
                      Enabled="{Binding enabled_unless_can_manage}"
                      AccessibleName="{Res admin.det_field_kind}"
                      OnSelectedValueChanged="combo_box_selected_value_changed2"/>
          </Panel>
          <Panel Visible="{Binding show_form_kind_wordlist}" Class="mt-3">
            <!-- TODO(views-migrate): <label htmlFor>: attribute(s) without a .kbview property -->
            <ReactHost Component="{Binding Part1}" Props="{Binding part1_props}"/>
            <!-- TODO(views-migrate): <textarea> has no .kbview element yet -->
            <ReactHost Component="{Binding Part2}" Props="{Binding part2_props}"/>
            <Label Text="{Res admin.det_field_terms_hint, Max={Binding det_field_terms_hint_max}}"
                   Overflow="Wrap"
                   ForeColor="TextTertiary"
                   InheritFontSize="true"
                   Class="mt-1 [font-size:var(--kb-text-meta)]"/>
          </Panel>
          <Panel Visible="{Binding show_not_form_kind_wordlist}" Class="mt-3">
            <!-- TODO(views-migrate): <label htmlFor>: attribute(s) without a .kbview property -->
            <ReactHost Component="{Binding Part3}" Props="{Binding part3_props}"/>
            <!-- TODO(views-migrate): <textarea> has no .kbview element yet -->
            <ReactHost Component="{Binding Part4}" Props="{Binding part4_props}"/>
            <Label Text="{Res admin.det_field_pattern_hint, Max={Binding det_field_pattern_hint_max}}"
                   Overflow="Wrap"
                   ForeColor="TextTertiary"
                   InheritFontSize="true"
                   Class="mt-1 [font-size:var(--kb-text-meta)]"/>
          </Panel>
          <Panel Visible="{Binding show_form_kind_checksum}" Class="mt-3 max-w-xs">
            <Label HtmlTag="Span"
                   Text="{Res admin.det_field_checksum}"
                   Overflow="Wrap"
                   ForeColor="TextSecondary"
                   InheritFontSize="true"
                   Class="block [font-size:var(--kb-text-meta)]"/>
            <Panel Class="mt-1">
              <ComboBox HostStrings="true"
                        SelectedValue="{Binding form.checksum}"
                        ItemsSource="{Binding checksumOptions}"
                        Enabled="{Binding enabled_unless_can_manage2}"
                        AccessibleName="{Res admin.det_field_checksum}"
                        OnSelectedValueChanged="combo_box_selected_value_changed3"/>
            </Panel>
            <Label Text="{Res admin.det_field_checksum_hint}"
                   Overflow="Wrap"
                   ForeColor="TextTertiary"
                   InheritFontSize="true"
                   Class="mt-1 [font-size:var(--kb-text-meta)]"/>
          </Panel>
        </Panel>
      </Card>
      <Card Title="{Res admin.det_block_proximity}" Subtitle="{Res admin.det_block_proximity_help}">
        <Panel Class="contents">
          <!-- TODO(views-migrate): <label htmlFor>: attribute(s) without a .kbview property -->
          <ReactHost Component="{Binding Part5}" Props="{Binding part5_props}"/>
          <!-- TODO(views-migrate): <textarea> has no .kbview element yet -->
          <ReactHost Component="{Binding Part6}" Props="{Binding part6_props}"/>
          <Panel Class="mt-3 grid gap-3 sm:grid-cols-2">
            <!-- TODO(views-migrate): <TextField> min, max: no .kbview property -->
            <ReactHost Component="{Binding Part7}" Props="{Binding part7_props}"/>
          </Panel>
          <Panel Class="mt-3">
            <Switch Label="{Res admin.det_field_proximity_required}"
                    Description="{Res admin.det_field_proximity_required_hint}"
                    On="{Binding form.proximity_required}"
                    Enabled="{Binding enabled_unless_can_manage}"
                    OnCheckedChanged="switch_checked_changed2"/>
          </Panel>
        </Panel>
      </Card>
      <Card Title="{Res admin.det_block_thresholds}" Subtitle="{Res admin.det_block_thresholds_help}">
        <Panel Class="contents">
          <Panel Class="grid gap-3 sm:grid-cols-3">
            <!-- TODO(views-migrate): <TextField> min, max, step: no .kbview property -->
            <ReactHost Component="{Binding Part8}" Props="{Binding part7_props}"/>
            <!-- TODO(views-migrate): <TextField> min, max, step: no .kbview property -->
            <ReactHost Component="{Binding Part9}" Props="{Binding part7_props}"/>
            <!-- TODO(views-migrate): <TextField> min, max, step: no .kbview property -->
            <ReactHost Component="{Binding Part10}" Props="{Binding part7_props}"/>
          </Panel>
          <Panel Class="mt-4 grid gap-3 sm:grid-cols-3">
            <!-- TODO(views-migrate): <TextField> min, max, step: no .kbview property -->
            <ReactHost Component="{Binding Part11}" Props="{Binding part7_props}"/>
            <!-- TODO(views-migrate): <TextField> min, max: no .kbview property -->
            <ReactHost Component="{Binding Part12}" Props="{Binding part7_props}"/>
            <!-- TODO(views-migrate): <TextField> min, max: no .kbview property -->
            <ReactHost Component="{Binding Part13}" Props="{Binding part7_props}"/>
          </Panel>
        </Panel>
      </Card>
      <Panel Class="min-w-0 lg:col-span-2">
        <DetectorTrial DetectorId="{Binding props.id}" Draft="{Binding detectorDraft}" DraftError="{Binding draftError}"/>
      </Panel>
    </Panel>
    <Stack Direction="LeftToRight" CrossAlign="Center" WrapContents="true" Visible="{Binding canManage}" Class="mt-4">
      <Button Size="Sm" IconSize="14" Icon="Save" Loading="{Binding busy}" Text="{Res admin.det_save}" OnClick="button_click2"/>
      <Button Variant="Secondary" Size="Sm" Enabled="{Binding enabled_unless_busy}" Text="{Res admin.det_cancel}" OnClick="button_click3"/>
      <Label HtmlTag="Span"
             Text="{Res admin.det_saved}"
             Overflow="Wrap"
             ForeColor="Success"
             InheritFontSize="true"
             Visible="{Binding saved}"
             Class="[font-size:var(--kb-text-meta)]"/>
    </Stack>
  </Panel>
</UserControl>
