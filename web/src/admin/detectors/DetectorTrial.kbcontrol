<!-- DetectorTrial — converted from DetectorTrial.tsx by @kubuno/views-migrate (partial: see the TODO comments and the report). -->
<UserControl x:Props="Props">
  <Card Title="{Res admin.det_trial_title}"
        IconSize="16"
        IconColor="TextSecondary"
        Icon="FlaskConical"
        Subtitle="{Res admin.det_trial_subtitle}">
    <Panel Class="contents">
      <!-- TODO(views-migrate): <label htmlFor>: attribute(s) without a .kbview property -->
      <ReactHost Component="{Binding Part1}" Props="{Binding part1_props}"/>
      <!-- TODO(views-migrate): <textarea> has no .kbview element yet -->
      <ReactHost Component="{Binding Part2}" Props="{Binding part2_props}"/>
      <Stack Direction="LeftToRight" CrossAlign="Center" WrapContents="true" Class="mt-2">
        <Button Variant="Secondary"
                Size="Sm"
                Loading="{Binding trial.isPending}"
                Enabled="{Binding enabled_unless_sample_trim}"
                Text="{Res admin.det_trial_run}"
                OnClick="button_click"/>
        <Label HtmlTag="Span"
               Text="{Res admin.det_trial_nothing_stored}"
               Overflow="Wrap"
               ForeColor="TextTertiary"
               InheritFontSize="true"
               Class="[font-size:var(--kb-text-meta)]"/>
      </Stack>
      <Label Text="{Binding error}"
             Overflow="Wrap"
             ForeColor="Danger"
             InheritFontSize="true"
             AccessibleRole="Alert"
             Visible="{Binding show_error}"
             Class="mt-2 [font-size:var(--kb-text-body)]"/>
      <Panel Visible="{Binding show_result}" Class="mt-4 min-w-0">
        <Callout Variant="{Binding variant}"
                 Title="{Binding title}"
                 Body="{Res admin.det_trial_counts, Count={Binding det_trial_counts_count}, Unique={Binding det_trial_counts_unique}, Best={Binding det_trial_counts_best}, MinMatches={Binding det_trial_counts_min_matches}, MinUnique={Binding det_trial_counts_min_unique}, MinConfidence={Binding det_trial_counts_min_confidence}}"/>
        <Panel Visible="{Binding show_result_scan_truncated}" Class="mt-2">
          <!-- TODO(views-migrate): <Callout> with element children -->
          <ReactHost Component="{Binding Part3}" Props="{Binding part3_props}"/>
        </Panel>
        <Panel ForeColor="TextPrimary"
               BackColor="Surface1"
               Class="mt-3 max-h-64 overflow-auto whitespace-pre-wrap break-words rounded-md border border-border p-3 font-mono [font-size:var(--kb-text-body)]">
          <!-- TODO(views-migrate): a list whose item is not a single element -->
          <ReactHost Component="{Binding Part4}" Props="{Binding part4_props}"/>
        </Panel>
      </Panel>
    </Panel>
  </Card>
</UserControl>
