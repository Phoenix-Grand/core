<!-- NetworkPanel — converted from NetworkPanel.tsx by @kubuno/views-migrate (partial: see the TODO comments and the report). -->
<Panel Class="max-w-4xl space-y-6">
  <Panel HtmlTag="Header">
    <Panel HtmlTag="H1" ForeColor="TextPrimary" Class="flex items-center gap-2 text-2xl font-semibold">
      <Icon Name="ShieldCheck" Size="24" Class="h-6 w-6 text-primary"/>
      <Label HtmlTag="Span" InheritFontSize="true" Overflow="Wrap" Text="{Binding text}"/>
    </Panel>
    <Label Text="{Binding p_text}" Overflow="Wrap" ForeColor="TextSecondary" Class="mt-1"/>
  </Panel>
  <Callout Title="{Binding title}" Body="{Binding callout_text}" Visible="{Binding show_runtime_file_override}"/>
  <Callout Variant="Warning" Title="{Binding title2}" Body="{Binding callout_text2}" Visible="{Binding show_runtime_restart_required}"/>
  <Card Class="p-5">
    <Stack Direction="LeftToRight" Gap="12" CrossAlign="Center">
      <Icon Name="Lock" Size="24" Visible="{Binding show_runtime_https_live}" Class="h-5 w-5 text-success"/>
      <Icon Name="LockOpen" Size="24" Visible="{Binding show_not_runtime_https_live}" Class="h-5 w-5 text-text-tertiary"/>
      <Panel>
        <Label HtmlTag="Div" Text="{Binding div_text}" FontWeight="Medium" Overflow="Wrap" ForeColor="TextPrimary" InheritFontSize="true"/>
        <Label HtmlTag="Div" Text="{Binding div_text2}" Overflow="Wrap" ForeColor="TextSecondary"/>
      </Panel>
    </Stack>
  </Card>
  <Card Class="p-5 space-y-4">
    <Panel Class="contents">
      <Label HtmlTag="H2" Text="{Binding h2_text}" FontWeight="SemiBold" Overflow="Wrap" ForeColor="TextPrimary" Class="text-lg"/>
      <Panel Visible="{Binding show_cert}" Class="space-y-1 text-sm">
        <Panel>
          <Label HtmlTag="Span" Text="{Binding span_text}" Overflow="Wrap" ForeColor="TextSecondary" InheritFontSize="true"/>
          <Label HtmlTag="Span"
                 Text="{Binding span_text2}"
                 FontWeight="Medium"
                 Overflow="Wrap"
                 ForeColor="TextPrimary"
                 InheritFontSize="true"/>
        </Panel>
        <Panel Visible="{Binding show_cert_san}">
          <Label HtmlTag="Span" Text="{Binding span_text3}" Overflow="Wrap" ForeColor="TextSecondary" InheritFontSize="true"/>
          <Label HtmlTag="Span" Text="{Binding span_text4}" Overflow="Wrap" ForeColor="TextPrimary" InheritFontSize="true"/>
        </Panel>
        <Panel>
          <Label HtmlTag="Span" Text="{Binding span_text5}" Overflow="Wrap" ForeColor="TextSecondary" InheritFontSize="true"/>
          <Label HtmlTag="Span" Text="{Binding span_text6}" Overflow="Wrap" ForeColor="TextPrimary" InheritFontSize="true"/>
        </Panel>
        <Stack Direction="LeftToRight" Gap="6" CrossAlign="Center" Visible="{Binding show_cert_not_after}">
          <Label HtmlTag="Span" Text="{Binding span_text7}" Overflow="Wrap" ForeColor="TextSecondary" InheritFontSize="true"/>
          <Label HtmlTag="Span" Text="{Binding span_text8}" Overflow="Wrap" ForeColor="TextPrimary" InheritFontSize="true"/>
          <Label HtmlTag="Span"
                 Text="{Binding span_text9}"
                 Overflow="Wrap"
                 InheritFontSize="true"
                 Visible="{Binding show_expires_in}"
                 Class="{Binding span_class}"/>
        </Stack>
        <Label HtmlTag="Div" Text="{Binding div_text3}" Overflow="Wrap" ForeColor="TextTertiary" InheritFontSize="true"/>
        <Panel Class="pt-2">
          <!-- TODO(views-migrate): <Button> with element children -->
          <ReactHost Component="{Binding Part1}" Props="{Binding part1_props}"/>
        </Panel>
      </Panel>
      <!-- TODO(views-migrate): <Callout> icon: a value the property converts (null-when-false) -->
      <ReactHost Component="{Binding Part2}" Props="{Binding part2_props}" Visible="{Binding show_not_cert}"/>
      <Panel Class="space-y-3 border-t border-border pt-4">
        <Label HtmlTag="Div" Text="{Binding div_text4}" FontWeight="Medium" Overflow="Wrap" ForeColor="TextPrimary"/>
        <!-- TODO(views-migrate): <TextArea> spellCheck: no .kbview property -->
        <ReactHost Component="{Binding Part3}" Props="{Binding part3_props}"/>
        <!-- TODO(views-migrate): <TextArea> spellCheck: no .kbview property -->
        <ReactHost Component="{Binding Part4}" Props="{Binding part4_props}"/>
        <Label Text="{Binding p_text2}" Role="Meta" Overflow="Wrap" ForeColor="TextTertiary"/>
        <!-- TODO(views-migrate): <Button> with element children -->
        <ReactHost Component="{Binding Part5}" Props="{Binding part5_props}"/>
      </Panel>
    </Panel>
  </Card>
  <Card Visible="{Binding acmeMode}" Class="p-5 space-y-4">
    <Panel Class="contents">
      <Label HtmlTag="H2" Text="{Binding h2_text2}" FontWeight="SemiBold" Overflow="Wrap" ForeColor="TextPrimary" Class="text-lg"/>
      <Label Text="{Binding p_text3}" Overflow="Wrap" ForeColor="TextSecondary"/>
      <Panel Visible="{Binding show_acme}" Class="space-y-1 text-sm">
        <Panel>
          <Label HtmlTag="Span" Text="{Binding span_text10}" Overflow="Wrap" ForeColor="TextSecondary" InheritFontSize="true"/>
          <Label HtmlTag="Span" Text="{Binding span_text11}" Overflow="Wrap" ForeColor="TextPrimary" InheritFontSize="true"/>
        </Panel>
        <Stack Direction="LeftToRight" Gap="6" CrossAlign="Start" Visible="{Binding show_acme_last_order}">
          <Label HtmlTag="Span" Text="{Binding span_text12}" Overflow="Wrap" ForeColor="TextSecondary" InheritFontSize="true"/>
          <Label HtmlTag="Span" Text="{Binding span_text13}" Overflow="Wrap" InheritFontSize="true" Class="{Binding span_class2}"/>
          <Label HtmlTag="Span"
                 Text="{Binding span_text14}"
                 Overflow="Wrap"
                 ForeColor="TextTertiary"
                 InheritFontSize="true"
                 Visible="{Binding show_acme_last_attempt}"/>
        </Stack>
        <Label HtmlTag="Div"
               Text="{Binding div_text5}"
               Overflow="Wrap"
               ForeColor="TextTertiary"
               InheritFontSize="true"
               Visible="{Binding show_acme_last_order2}"
               Class="break-words"/>
      </Panel>
      <!-- TODO(views-migrate): <Button> with element children -->
      <ReactHost Component="{Binding Part6}" Props="{Binding part6_props}"/>
    </Panel>
  </Card>
  <Card Visible="{Binding show_history}" Class="p-5 space-y-3">
    <Panel Class="contents">
      <Label HtmlTag="H2" Text="{Binding h2_text3}" FontWeight="SemiBold" Overflow="Wrap" ForeColor="TextPrimary" Class="text-lg"/>
      <Label Text="{Binding p_text4}" Overflow="Wrap" ForeColor="TextSecondary"/>
      <Panel HtmlTag="Ul" Class="divide-y divide-border">
        <Repeater ItemKey="key" ItemsSource="{Binding rows_history}">
          <Panel HtmlTag="Li" Class="flex items-center justify-between gap-3 py-2 text-sm">
            <Panel Class="min-w-0">
              <Label HtmlTag="Div" Text="{Binding div_text}" ForeColor="TextPrimary" InheritFontSize="true"/>
              <Label HtmlTag="Div" Text="{Binding div_text2}" Overflow="Wrap" ForeColor="TextTertiary" InheritFontSize="true"/>
            </Panel>
            <!-- TODO(views-migrate): <Button> with element children -->
            <ReactHost Component="{Binding Part7}" Props="{Binding part7_props}"/>
          </Panel>
        </Repeater>
      </Panel>
    </Panel>
  </Card>
  <!-- TODO(views-migrate): <SettingsGroupPanel> is no .kbview element (./settings/SettingsGroupPanel#default) -->
  <ReactHost Component="{Binding SettingsGroupPanel}" Props="{Binding settings_group_panel_props}"/>
  <!-- TODO(views-migrate): <ConfirmDialog {...spread}> (spread props) -->
  <ReactHost Component="{Binding ConfirmDialog}" Props="{Binding confirm_dialog_props}" Visible="{Binding show_confirm_state}"/>
</Panel>
