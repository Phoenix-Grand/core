<!-- MockUploadPanel — converted from MockUploadPanel.tsx by @kubuno/views-migrate. -->
<UserControl>
  <Panel Class="w-72 bg-white rounded-xl shadow-xl border border-border overflow-hidden">
    <Stack Direction="LeftToRight" CrossAlign="Center" BackColor="Surface1" Class="px-4 py-3 border-b border-border">
      <Icon Name="Loader2" Size="14" Class="animate-spin text-primary"/>
      <Label HtmlTag="Span" Text="Import en cours…" FontWeight="Medium" Overflow="Wrap" ForeColor="TextPrimary"/>
    </Stack>
    <Panel HtmlTag="Ul" Class="divide-y divide-border">
      <Panel HtmlTag="Li" Class="flex items-center gap-3 px-4 py-2.5">
        <Panel Class="flex-1 min-w-0">
          <Label Text="presentation.pptx" Role="Meta" ForeColor="TextPrimary"/>
          <Panel BackColor="Surface2" Class="mt-1 h-1 w-full rounded-full overflow-hidden">
            <Panel BackColor="Primary" Class="h-full rounded-full [width:64%]"/>
          </Panel>
        </Panel>
      </Panel>
      <Panel HtmlTag="Li" Class="flex items-center gap-3 px-4 py-2.5">
        <Panel Class="flex-1 min-w-0">
          <Label Text="notes.txt" Role="Meta" ForeColor="TextPrimary"/>
        </Panel>
        <Icon Name="CheckCircle2" Size="14" Class="text-success shrink-0"/>
      </Panel>
    </Panel>
  </Panel>
</UserControl>
