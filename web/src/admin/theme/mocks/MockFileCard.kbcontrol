<!-- MockFileCard — converted from MockFileCard.tsx by @kubuno/views-migrate. -->
<UserControl x:Props="MockFileCardProps">
  <Panel Class="{Binding div_class}">
    <Stack Direction="LeftToRight" CrossAlign="Center" Class="px-3 h-10">
      <Icon Name="FileText" Size="18" Class="shrink-0 text-text-secondary"/>
      <Label HtmlTag="Span" Text="{Binding name}" Role="Meta" FontWeight="Medium" ForeColor="TextPrimary" Class="flex-1"/>
      <Icon Name="Star" Size="12" Class="shrink-0 fill-yellow-400 text-yellow-400"/>
      <Icon Name="MoreVertical" Size="14" Class="shrink-0 text-text-secondary opacity-0 group-hover:opacity-100"/>
    </Stack>
    <Stack Direction="LeftToRight"
           Gap="0"
           CrossAlign="Center"
           Justify="Center"
           Class="relative overflow-hidden rounded-lg bg-white mx-2 mb-2 h-24">
      <Icon Name="FileText" Size="40" Class="text-text-tertiary"/>
    </Stack>
    <Panel HtmlTag="Span"
           Class="absolute z-10 inline-block pointer-events-none [bottom:4px] [right:4px] [padding:7px] [border-radius:12px_0_0_0] [background-color:inherit] [transition:background-color_150ms_cubic-bezier(0.4,_0,_0.2,_1)]">
      <Label HtmlTag="Span"
             Text="{Binding ext}"
             FontWeight="SemiBold"
             Overflow="Wrap"
             ForeColor="TextSecondary"
             InheritFontSize="true"
             Class="block uppercase [font-size:10px] [line-height:1] [padding:2px_5px] [letter-spacing:0.04em] [border-radius:6px]"/>
    </Panel>
  </Panel>
</UserControl>
