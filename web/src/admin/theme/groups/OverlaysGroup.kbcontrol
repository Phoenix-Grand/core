    <Label Text="{Res admin.t_prev_overlays_hint}" Overflow="Wrap" ForeColor="TextTertiary" Class="text-[11px] mb-2.5 -mt-1"/>
    <Stack Direction="LeftToRight" Gap="16" CrossAlign="Start" WrapContents="true">
      <!-- TODO(views-migrate): <PreviewStage> is no .kbview element (../PreviewStage#default) -->
      <ReactHost Component="{Binding Part1}" Props="{Binding part1_props}"/>
      <!-- TODO(views-migrate): <PreviewStage> is no .kbview element (../PreviewStage#default) -->
      <ReactHost Component="{Binding Part2}" Props="{Binding part1_props}"/>
      <!-- TODO(views-migrate): <PreviewStage> is no .kbview element (../PreviewStage#default) -->
      <ReactHost Component="{Binding Part3}" Props="{Binding part1_props}"/>
      <!-- TODO(views-migrate): <PreviewStage> is no .kbview element (../PreviewStage#default) -->
      <ReactHost Component="{Binding Part4}" Props="{Binding part1_props}"/>
    </Stack>
  </Panel>
</UserControl>
