<!-- PrimitivesGroup — converted from PrimitivesGroup.tsx by @kubuno/views-migrate (partial: see the TODO comments and the report). -->
<UserControl>
  <Panel Class="contents">
    <Stack Direction="LeftToRight" CrossAlign="Center" WrapContents="true" Class="mb-3">
      <Button Size="Sm" Text="Primaire"/>
      <Button Variant="Secondary" Size="Sm" Text="Secondaire"/>
      <Button Variant="Ghost" Size="Sm" Text="Ghost"/>
      <Button Variant="Danger" Size="Sm" Text="Danger"/>
      <Button Size="Sm" Loading="true" Text="…"/>
    </Stack>
    <Stack Direction="LeftToRight" CrossAlign="Center" WrapContents="true" Class="mb-3">
      <Badge Text="Défaut"/>
      <Badge Variant="Success" Text="Succès"/>
      <Badge Variant="Danger" Text="Erreur"/>
      <Badge Variant="Warning" Text="Alerte"/>
      <Badge Dot="true" Variant="Primary" Text="En ligne"/>
    </Stack>
    <Stack Direction="LeftToRight" Gap="16" CrossAlign="Center" WrapContents="true">
      <Panel Class="w-48">
        <!-- TODO(views-migrate): <TextField LeftIcon>: an icon size the element cannot take -->
        <ReactHost Component="{Binding Part1}"/>
      </Panel>
      <CheckBox Checked="{Binding chk, Mode=TwoWay}" Text="Case à cocher"/>
      <RadioButton SelectedValue="true" Value="true" Text="Option" OnCheckedChanged="radio_button_checked_changed"/>
      <Switch On="{Binding tgl, Mode=TwoWay}" Label="Bascule"/>
      <Spinner Size="Sm"/>
      <Separator Orientation="Vertical" Class="h-6"/>
    </Stack>
    <Stack Direction="LeftToRight" Gap="24" CrossAlign="Center" WrapContents="true" Class="mt-4">
      <Panel Class="w-56">
        <Label HtmlTag="Span" Text="{Res admin.t_prev_slider}" Role="Meta" Overflow="Wrap" ForeColor="TextTertiary" Class="block mb-1.5"/>
        <Slider Value="{Binding slide, Mode=TwoWay}" Maximum="100"/>
      </Panel>
      <Panel Class="w-56">
        <Label HtmlTag="Span" Text="{Res admin.t_prev_datetime}" Role="Meta" Overflow="Wrap" ForeColor="TextTertiary" Class="block mb-1.5"/>
        <!-- TODO(views-migrate): <DatePicker mode="datetime">: no .kbview value -->
        <ReactHost Component="{Binding Part2}" Props="{Binding part2_props}"/>
      </Panel>
    </Stack>
  </Panel>
</UserControl>
