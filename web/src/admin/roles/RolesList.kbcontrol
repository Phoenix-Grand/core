<!-- RolesList — converted from RolesList.tsx by @kubuno/views-migrate (partial: see the TODO comments and the report). -->
<UserControl x:Props="RolesListProps">
  <Panel Class="space-y-4">
    <Callout Body="{Res admin.roles_readonly}" Visible="{Binding show_can_grant}"/>
    <!-- TODO(views-migrate): <DataTable> rowKey, onRetry, filtered, onClearFilters, toolbar, emptyState, columns, rowActions, t: no .kbview property -->
    <ReactHost Component="{Binding Part1}" Props="{Binding part1_props}"/>
    <!-- TODO(views-migrate): <AssignRoleDialog> is no .kbview element (./AssignRoleDialog#default) -->
    <ReactHost Component="{Binding AssignRoleDialog}" Props="{Binding assign_role_dialog_props}" Visible="{Binding show_assign}"/>
    <!-- TODO(views-migrate): <RoleCreateDialog> is no .kbview element (./RoleCreateDialog#default) -->
    <ReactHost Component="{Binding RoleCreateDialog}" Props="{Binding role_create_dialog_props}" Visible="{Binding creating}"/>
    <!-- TODO(views-migrate): <ConfirmDialog {...spread}> (spread props) -->
    <ReactHost Component="{Binding ConfirmDialog}" Props="{Binding confirm_dialog_props}" Visible="{Binding show_confirm_state}"/>
  </Panel>
</UserControl>
