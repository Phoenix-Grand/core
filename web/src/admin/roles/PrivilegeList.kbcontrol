<!-- PrivilegeList — converted from PrivilegeList.tsx by @kubuno/views-migrate (partial: see the TODO comments and the report). -->
<UserControl x:Props="PrivilegeListProps">
  <Panel Class="contents">
    <Label Text="{Res admin.priv_none}" Overflow="Wrap" ForeColor="TextTertiary" Visible="{Binding show_case_1}" Class="py-3"/>
    <Panel Visible="{Binding show_main}" Class="{Binding div_class}">
      <Repeater ItemKey="key" ItemsSource="{Binding rows_groups}">
        <Panel>
          <Label Text="{Binding p_text}" Overflow="Wrap" Class="{Binding p_class}"/>
          <!-- TODO(views-migrate): a list inside a list (nested Repeater) -->
          <ReactHost Component="{Binding Part1}" Props="{Binding part1_props}"/>
        </Panel>
      </Repeater>
    </Panel>
  </Panel>
</UserControl>
