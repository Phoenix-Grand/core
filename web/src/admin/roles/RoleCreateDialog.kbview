<!-- RoleCreateDialog — converted from RoleCreateDialog.tsx by @kubuno/views-migrate (partial: see the TODO comments and the report). -->
<FloatingWindow x:Props="RoleCreateDialogProps"
                ConfirmText="{Res settings.create}"
                ConfirmEnabled="{Binding enabled_unless_name_trim}"
                ConfirmBusy="{Binding create.isPending}"
                CancelText="{Res common.cancel}"
                HostStrings="true"
                Title="{Res admin.roles_create}"
                Width="680"
                Modal="true"
                OnConfirm="floating_window_confirm"
                OnClose="floating_window_close">
  <Panel HtmlTag="Form" Class="flex flex-col max-h-[78vh]" OnSubmit="panel_submit">
    <Panel Class="p-5 space-y-4 overflow-y-auto">
      <Panel Class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <!-- TODO(views-migrate): <TextField> label: an object value for a text property -->
        <ReactHost Component="{Binding Part1}" Props="{Binding part1_props}"/>
        <TextField Label="{Res admin.role_slug}"
                   Text="{Binding slug}"
                   Placeholder="admin-marketing"
                   Hint="{Res admin.role_slug_hint}"
                   OnTextChanged="text_field_text_changed"/>
      </Panel>
      <!-- TODO(views-migrate): <TextArea> rows: no .kbview property -->
      <ReactHost Component="{Binding Part2}" Props="{Binding part2_props}"/>
      <Panel Class="flex items-baseline justify-between gap-4 flex-wrap">
        <!-- TODO(views-migrate): <FieldLabel> is no .kbview element (../sections/resources/FieldLabel#default) -->
        <ReactHost Component="{Binding Part3}" Props="{Binding part3_props}"/>
        <Label Text="{Res admin.priv_selected, Count={Binding selected.size}}" Overflow="Wrap" ForeColor="TextSecondary"/>
      </Panel>
      <Callout Variant="Warning"
               Title="{Res admin.role_not_delegable_title}"
               Body="{Res admin.role_not_delegable_desc, Count={Binding blockers.length}}"
               Visible="{Binding show_blockers}"/>
      <Callout Variant="Success" Title="{Res admin.role_delegable_title}" Body="{Res admin.role_delegable_desc}" Visible="{Binding visible}"/>
      <Panel Class="border border-border rounded-lg overflow-hidden">
        <PrivilegeList Keys="{Binding keys}" Catalogue="{Binding props.catalogue}" Selected="{Binding selected}" OnToggle="privilege_list_toggle"/>
      </Panel>
      <Callout Variant="Danger" Body="{Binding error}" Visible="{Binding show_error}"/>
    </Panel>
  </Panel>
</FloatingWindow>
