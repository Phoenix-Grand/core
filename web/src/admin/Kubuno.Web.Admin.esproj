<Project Sdk="Microsoft.VisualStudio.JavaScript.Sdk/1.0.6887863">
  <!-- npm/Vite through the Kubuno tooling (docs/WEB.md, "Frontends"): Windows native packages when node_modules
       was installed by Linux, Node.js from Visual Studio when none is on PATH, no npm install over a foreign tree. -->
  <Sdk Name="Kubuno.Web.Sdk" Version="1.0.1" />

  <!-- Generated by "Kubuno Web: Generate Solution" (docs/WEB.md). This file is yours: never overwritten by a later run. -->
  <PropertyGroup>
    <KubunoWebRole>Package</KubunoWebRole>
    <!-- The Kubuno core admin console: a part of the host app, CO-LOCATED with its sources (web/src/admin, this
         folder = disk). NOT an npm package (no KubunoPackageId, not published): it is compiled by the host app's own
         build and lazy-loaded at runtime. This project exists only to group the console under its own node in Solution
         Explorer (the host app project hides web/src/admin). node_modules is the host app's (two levels up). -->
    <KubunoNodeModulesDirectory>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..'))\</KubunoNodeModulesDirectory>
    <!-- Build outputs are not sources (obj\ already excluded by the SDK). -->
    <DefaultItemExcludes>$(DefaultItemExcludes);*.tgz</DefaultItemExcludes>
  </PropertyGroup>

</Project>
