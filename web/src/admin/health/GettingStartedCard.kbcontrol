<!-- GettingStartedCard — converted from GettingStartedCard.tsx by @kubuno/views-migrate (partial: see the TODO comments and the report). -->
<UserControl>
  <Panel Class="contents">
    <Panel ForeColor="TextSecondary" Visible="{Binding show_case_2}" Class="mb-4 flex items-center gap-2 [font-size:var(--kb-text-body)]">
      <Icon Name="CheckCircle2" Size="16" Class="shrink-0 text-success"/>
      <Label HtmlTag="Span" Text="{Res admin.hc_all_clear}" Overflow="Wrap" InheritFontSize="true"/>
      <LinkLabel Href="{Binding href}"
                 Text="{Res admin.hc_open_page}"
                 ForeColor="Primary"
                 InheritFontSize="true"
                 Class="rounded-sm underline-offset-2 hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-primary"
                 OnClick="link_label_click"/>
    </Panel>
    <Card IconSize="18"
          Icon="HeartPulse"
          Title="{Res admin.hc_getting_started}"
          Subtitle="{Res admin.hc_getting_started_sub}"
          Visible="{Binding show_main}"
          Class="mb-10">
      <Card.Footer>
        <!-- TODO(views-migrate): <Link style> -->
        <ReactHost Component="{Binding Part1}" Props="{Binding part1_props}"/>
      </Card.Footer>
      <Panel Class="contents">
        <!-- TODO(views-migrate): <ProgressBar> formatValue: no .kbview property -->
        <ReactHost Component="{Binding Part2}" Props="{Binding part2_props}"/>
        <Panel HtmlTag="Ul" Class="min-w-0">
          <Repeater ItemKey="key" ItemsSource="{Binding rows_shown}">
            <!-- TODO(views-migrate): <TaskRow> is no .kbview element (a local or dynamic component) -->
            <ReactHost Component="{Binding TaskRow}" Props="{Binding task_row_props}"/>
          </Repeater>
        </Panel>
      </Panel>
    </Card>
  </Panel>
</UserControl>
