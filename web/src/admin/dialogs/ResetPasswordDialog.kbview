<!-- ResetPasswordDialog — converted from ResetPasswordDialog.tsx by @kubuno/views-migrate (partial: see the TODO comments and the report). -->
<Panel x:Props="ResetPasswordDialogProps" Class="contents">
  <FloatingWindow Title="{Res pwreset.done_title}"
                  IconSize="16"
                  Icon="KeyRound"
                  Width="460"
                  Modal="true"
                  Visible="{Binding show_case_1}"
                  OnClose="floating_window_close">
    <Stack Gap="16" Class="p-5">
      <Panel Visible="{Binding show_outcome_password}">
        <Label Text="{Res pwreset.password}"
               Overflow="Wrap"
               ForeColor="TextSecondary"
               InheritFontSize="true"
               Class="[font-size:var(--kb-text-meta)]"/>
        <Stack Direction="LeftToRight" CrossAlign="Center" Class="mt-1">
          <Label HtmlTag="Code"
                 Text="{Binding code_text}"
                 ForeColor="TextPrimary"
                 BackColor="Surface1"
                 InheritFontSize="true"
                 Class="min-w-0 flex-1 rounded-lg border border-border px-3 py-2 font-mono [font-size:var(--kb-text-body)]"/>
          <Panel AccessibleRole="PushButton"
                 AutoSize="true"
                 ForeColor="TextSecondary"
                 AccessibleName="{Binding accessible_name}"
                 ToolTip="{Binding accessible_name}"
                 Class="rounded-lg p-2 hover:bg-surface-2"
                 OnClick="panel_click">
            <Icon Name="EyeOff" Size="16" Visible="{Binding revealed}"/>
            <Icon Name="Eye" Size="16" Visible="{Binding show_not_revealed}"/>
          </Panel>
          <Panel AccessibleRole="PushButton"
                 AutoSize="true"
                 ForeColor="TextSecondary"
                 AccessibleName="{Res pwreset.copy}"
                 ToolTip="{Res pwreset.copy}"
                 Class="rounded-lg p-2 hover:bg-surface-2"
                 OnClick="copy">
            <Icon Name="Check" Size="16" Visible="{Binding copied}" Class="text-success"/>
            <Icon Name="Copy" Size="16" Visible="{Binding show_not_copied}"/>
          </Panel>
        </Stack>
        <Label Text="{Res pwreset.copied}"
               Overflow="Wrap"
               ForeColor="Success"
               InheritFontSize="true"
               Visible="{Binding copied}"
               Class="mt-1 [font-size:var(--kb-text-meta)]"/>
      </Panel>
      <Label Text="{Res pwreset.no_password_shown}"
             Overflow="Wrap"
             ForeColor="TextSecondary"
             InheritFontSize="true"
             Visible="{Binding show_not_outcome_password}"
             Class="[font-size:var(--kb-text-body)]"/>
      <Panel HtmlTag="Ul" ForeColor="TextSecondary" Class="space-y-1 [font-size:var(--kb-text-body)]">
        <Label HtmlTag="Li" Text="{Binding li_text}" Overflow="Wrap" InheritFontSize="true"/>
        <Label HtmlTag="Li"
               Text="{Res pwreset.done_must_change}"
               Overflow="Wrap"
               InheritFontSize="true"
               Visible="{Binding show_outcome_must_change}"/>
      </Panel>
      <Callout Variant="Success" Body="{Res pwreset.email_queued, To={Binding email_queued_to}}" Visible="{Binding visible}"/>
      <Callout Variant="Warning" Body="{Res pwreset.email_not_configured}" Visible="{Binding visible2}"/>
      <Button Text="{Res pwreset.close}" Class="w-full" OnClick="button_click"/>
    </Stack>
  </FloatingWindow>
  <FloatingWindow Title="{Res pwreset.title}"
                  IconSize="16"
                  Icon="KeyRound"
                  Width="460"
                  Modal="true"
                  Visible="{Binding show_main}"
                  OnClose="floating_window_close2">
    <Stack Gap="16" Class="p-5">
      <Label Text="{Res pwreset.subtitle, User={Binding props.userLabel}}"
             Overflow="Wrap"
             ForeColor="TextSecondary"
             InheritFontSize="true"
             Class="[font-size:var(--kb-text-body)]"/>
      <Panel>
        <Label Text="{Res pwreset.mode}"
               Overflow="Wrap"
               ForeColor="TextSecondary"
               InheritFontSize="true"
               Class="mb-2 [font-size:var(--kb-text-meta)]"/>
        <Stack CrossAlign="Start">
          <RadioButton SelectedValue="{Binding selected_value}"
                       Value="true"
                       Text="{Res pwreset.mode_generate}"
                       OnCheckedChanged="radio_button_checked_changed"/>
          <RadioButton SelectedValue="{Binding selected_value2}"
                       Value="true"
                       Text="{Res pwreset.mode_manual}"
                       OnCheckedChanged="radio_button_checked_changed2"/>
        </Stack>
      </Panel>
      <!-- TODO(views-migrate): <TextField> autoFocus: no .kbview property -->
      <ReactHost Component="{Binding Part1}" Props="{Binding part1_props}" Visible="{Binding selected_value2}"/>
      <Stack CrossAlign="Start">
        <CheckBox Checked="{Binding requireChange, Mode=TwoWay}" Text="{Res pwreset.require_change}"/>
        <CheckBox Checked="{Binding sendEmail, Mode=TwoWay}" Text="{Res pwreset.send_email}"/>
      </Stack>
      <TextField Text="{Binding emailTo, Mode=TwoWay}"
                 InputType="Email"
                 Placeholder="{Binding placeholder}"
                 Hint="{Res pwreset.send_email_to}"
                 AutoComplete="off"
                 Visible="{Binding sendEmail}"/>
      <Callout Variant="Warning" Body="{Res pwreset.warn_sessions}"/>
      <Callout Variant="Danger" Body="{Binding error}" Visible="{Binding show_error}"/>
      <Stack Direction="LeftToRight" Gap="12">
        <Button Variant="Secondary" Text="{Res common.cancel}" Class="flex-1" OnClick="button_click2"/>
        <Button Loading="{Binding reset.isPending}" Text="{Res pwreset.submit}" Class="flex-1" OnClick="submit"/>
      </Stack>
    </Stack>
  </FloatingWindow>
</Panel>
