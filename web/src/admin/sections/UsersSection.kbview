<!-- UsersSection — converted from UsersSection.tsx by @kubuno/views-migrate (partial: see the TODO comments and the report). -->
<Panel x:Props="AdminSectionProps" Class="contents">
  <!-- TODO(views-migrate): <UserDetailSection> is no .kbview element (./user-detail/UserDetailSection#default) -->
  <ReactHost Component="{Binding UserDetailSection}" Props="{Binding user_detail_section_props}" Visible="{Binding show_case_1}"/>
  <Label HtmlTag="H1"
         Text="{Res admin.tab_users}"
         FontWeight="Medium"
         Overflow="Wrap"
         ForeColor="TextPrimary"
         Visible="{Binding show_main}"
         Class="mb-6 text-xl"/>
  <!-- TODO(views-migrate): <UsersPanel> is no .kbview element (../UsersPanel#default) -->
  <ReactHost Component="{Binding UsersPanel}" Visible="{Binding show_main}"/>
</Panel>
