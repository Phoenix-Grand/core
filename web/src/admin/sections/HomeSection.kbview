<!-- HomeSection — converted from HomeSection.tsx by @kubuno/views-migrate (partial: see the TODO comments and the report). -->
<Panel>
  <Panel Class="mb-6">
    <Label HtmlTag="H1" Text="{Res admin.home_welcome_title}" FontWeight="Medium" Overflow="Wrap" ForeColor="TextPrimary" Class="text-2xl"/>
    <Label Text="{Res admin.home_welcome_sub}" Overflow="Wrap" ForeColor="TextSecondary" Class="mt-1"/>
  </Panel>
  <!-- TODO(views-migrate): <GettingStartedCard> is no .kbview element (../health/GettingStartedCard#default) -->
  <ReactHost Component="{Binding GettingStartedCard}"/>
  <Panel Class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-10 items-stretch">
    <!-- TODO(views-migrate): <HomeCard> is no .kbview element (a local or dynamic component) -->
    <ReactHost Component="{Binding Part1}" Props="{Binding part1_props}" Visible="{Binding show_sees_users}"/>
    <!-- TODO(views-migrate): <HomeCard> is no .kbview element (a local or dynamic component) -->
    <ReactHost Component="{Binding Part2}" Props="{Binding part2_props}" Visible="{Binding show_sees_modules}"/>
    <!-- TODO(views-migrate): <HomeCard> is no .kbview element (a local or dynamic component) -->
    <ReactHost Component="{Binding Part3}" Props="{Binding part3_props}" Visible="{Binding hasStats}"/>
    <!-- TODO(views-migrate): <HomeCard> is no .kbview element (a local or dynamic component) -->
    <ReactHost Component="{Binding Part4}" Props="{Binding part4_props}" Visible="{Binding show_sees_sso}"/>
    <!-- TODO(views-migrate): <AlertsCard> is no .kbview element (../alerts/AlertsCard#default) -->
    <ReactHost Component="{Binding AlertsCard}" Visible="{Binding show_sees_alerts}"/>
    <!-- TODO(views-migrate): <HomeCard> is no .kbview element (a local or dynamic component) -->
    <ReactHost Component="{Binding Part5}" Props="{Binding part5_props}" Visible="{Binding show_sees_groups}"/>
    <!-- TODO(views-migrate): <HomeCard> is no .kbview element (a local or dynamic component) -->
    <ReactHost Component="{Binding Part6}" Props="{Binding part6_props}" Visible="{Binding show_sees_settings}"/>
    <!-- TODO(views-migrate): <HomeCard> is no .kbview element (a local or dynamic component) -->
    <ReactHost Component="{Binding Part7}" Props="{Binding part7_props}" Visible="{Binding show_sees_event_log}"/>
  </Panel>
</Panel>
