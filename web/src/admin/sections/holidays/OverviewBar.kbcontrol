<!-- OverviewBar — converted from OverviewBar.tsx by @kubuno/views-migrate (partial: see the TODO comments and the report). -->
<UserControl x:Props="OverviewBarProps">
  <Stack Gap="12" Visible="{Binding show_main}">
    <Stack Direction="LeftToRight"
           Gap="24"
           CrossAlign="Start"
           WrapContents="true"
           BackColor="Surface1"
           Class="rounded border border-border px-4 py-3">
      <!-- TODO(views-migrate): <Figure> is no .kbview element (a local or dynamic component) -->
      <ReactHost Component="{Binding Figure}" Props="{Binding figure_props}"/>
      <!-- TODO(views-migrate): <Figure> is no .kbview element (a local or dynamic component) -->
      <ReactHost Component="{Binding Figure}" Props="{Binding figure_props2}"/>
      <!-- TODO(views-migrate): <Figure> is no .kbview element (a local or dynamic component) -->
      <ReactHost Component="{Binding Figure}" Props="{Binding figure_props3}"/>
      <!-- TODO(views-migrate): <Figure> is no .kbview element (a local or dynamic component) -->
      <ReactHost Component="{Binding Figure}" Props="{Binding figure_props4}"/>
      <Stack Direction="LeftToRight" Gap="12" CrossAlign="Center" Class="ms-auto">
        <Label HtmlTag="Span"
               Text="{Res admin.hol_dataset, Version={Binding hol_dataset_version}}"
               Overflow="Wrap"
               ForeColor="TextTertiary"
               InheritFontSize="true"
               Class="[font-size:var(--kb-text-small)]"/>
        <!-- TODO(views-migrate): <Button> with element children -->
        <ReactHost Component="{Binding Part1}" Props="{Binding part1_props}" Visible="{Binding props.canManage}"/>
      </Stack>
    </Stack>
    <Callout Variant="Warning" Body="{Res admin.hol_dataset_stale, Version={Binding hol_dataset_stale_version}}" Visible="{Binding stale}"/>
    <Callout Body="{Res admin.hol_orphans, Count={Binding hol_orphans_count}}" Visible="{Binding show_data_orphans}"/>
    <Label Text="{Binding error}"
           Overflow="Wrap"
           ForeColor="Danger"
           InheritFontSize="true"
           AccessibleRole="Alert"
           Visible="{Binding show_error}"
           Class="[font-size:var(--kb-text-body)]"/>
  </Stack>
</UserControl>
