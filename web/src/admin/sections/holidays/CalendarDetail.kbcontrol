<!-- CalendarDetail — converted from CalendarDetail.tsx by @kubuno/views-migrate (partial: see the TODO comments and the report). -->
<UserControl x:Props="CalendarDetailProps">
  <Stack Gap="16" Class="min-w-0">
    <Stack Direction="LeftToRight" CrossAlign="Center" WrapContents="true">
      <Button Variant="Ghost"
              Text="{Res admin.hol_open_parent, Name={Binding hol_open_parent_name}}"
              Visible="{Binding show_data_parent}"
              OnClick="button_click"/>
    </Stack>
    <Panel Class="min-w-0">
      <Panel HtmlTag="H2" ForeColor="TextPrimary" Class="min-w-0 [font-size:var(--kb-text-section)]">
        <Label HtmlTag="Span" InheritFontSize="true" Overflow="Wrap" Text="{Binding text}"/>
        <Label HtmlTag="Span"
               Text="{Binding span_text}"
               Overflow="Wrap"
               ForeColor="TextTertiary"
               InheritFontSize="true"
               Class="ms-2 [font-size:var(--kb-text-small)]"/>
      </Panel>
      <Label Text="{Res admin.hol_inherits_from, Name={Binding hol_open_parent_name}}"
             Overflow="Wrap"
             ForeColor="TextSecondary"
             InheritFontSize="true"
             Visible="{Binding show_data_parent}"
             Class="mt-1 [font-size:var(--kb-text-body)]"/>
    </Panel>
    <Callout Body="{Binding coverage}" Visible="{Binding show_coverage}"/>
    <Stack Direction="LeftToRight" Gap="12" CrossAlign="End" WrapContents="true">
      <NumericField Label="{Res admin.hol_preview_year}"
                    Value="{Binding year}"
                    Minimum="1970"
                    Maximum="2200"
                    FieldClass="w-32"
                    OnValueChanged="numeric_field_value_changed"/>
      <Panel Class="ms-auto">
        <!-- TODO(views-migrate): <Button> with element children -->
        <ReactHost Component="{Binding Part1}" Props="{Binding part1_props}" Visible="{Binding props.canManage}"/>
      </Panel>
    </Stack>
    <Label Text="{Binding error}"
           Overflow="Wrap"
           ForeColor="Danger"
           InheritFontSize="true"
           AccessibleRole="Alert"
           Visible="{Binding show_error}"
           Class="[font-size:var(--kb-text-body)]"/>
    <!-- TODO(views-migrate): <DataTable> t, columns, rowKey, rowActions, onRetry, emptyState: no .kbview property -->
    <ReactHost Component="{Binding Part2}" Props="{Binding part2_props}"/>
    <!-- TODO(views-migrate): <HolidayDialog> is no .kbview element (./HolidayDialog#default) -->
    <ReactHost Component="{Binding HolidayDialog}" Props="{Binding holiday_dialog_props}" Visible="{Binding show_editing}"/>
    <!-- TODO(views-migrate): <ConfirmDialog {...spread}> (spread props) -->
    <ReactHost Component="{Binding ConfirmDialog}" Props="{Binding confirm_dialog_props}" Visible="{Binding show_confirm_state}"/>
  </Stack>
</UserControl>
