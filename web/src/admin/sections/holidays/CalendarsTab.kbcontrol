<!-- CalendarsTab — converted from CalendarsTab.tsx by @kubuno/views-migrate (partial: see the TODO comments and the report). -->
<UserControl x:Props="CalendarsTabProps">
  <Stack Gap="12" Class="min-w-0">
    <Stack Direction="LeftToRight" Gap="12" CrossAlign="Center" WrapContents="true">
      <!-- TODO(views-migrate): <TextField LeftIcon>: an icon size the element cannot take -->
      <ReactHost Component="{Binding Part1}" Props="{Binding part1_props}"/>
      <CheckBox Checked="{Binding countriesOnly, Mode=TwoWay}" Text="{Res admin.hol_countries_only}"/>
      <Panel Class="ms-auto">
        <!-- TODO(views-migrate): <Button> with element children -->
        <ReactHost Component="{Binding Part2}" Props="{Binding part2_props}" Visible="{Binding props.canManage}"/>
      </Panel>
    </Stack>
    <Label Text="{Binding error}"
           Overflow="Wrap"
           ForeColor="Danger"
           InheritFontSize="true"
           AccessibleRole="Alert"
           Visible="{Binding show_error}"
           Class="[font-size:var(--kb-text-body)]"/>
    <!-- TODO(views-migrate): <DataTable> t, columns, rowKey, rowActions, onRowClick, onRetry, filtered, onClearFilters, emptyState: no .kbview property -->
    <ReactHost Component="{Binding Part3}" Props="{Binding part3_props}"/>
    <!-- TODO(views-migrate): <CalendarDialog> is no .kbview element (./CalendarDialog#default) -->
    <ReactHost Component="{Binding CalendarDialog}" Props="{Binding calendar_dialog_props}" Visible="{Binding creating}"/>
    <!-- TODO(views-migrate): <ConfirmDialog {...spread}> (spread props) -->
    <ReactHost Component="{Binding ConfirmDialog}" Props="{Binding confirm_dialog_props}" Visible="{Binding show_confirm_state}"/>
  </Stack>
</UserControl>
