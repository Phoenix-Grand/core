<!-- HolidayDialog — converted from HolidayDialog.tsx by @kubuno/views-migrate (partial: see the TODO comments and the report). -->
<Panel x:Props="HolidayDialogProps" OnMouseDown="panel_mouse_down">
  <FloatingWindow ConfirmText="{Res admin.hol_save}"
                  ConfirmEnabled="{Binding enabled_unless_busy_name_trim}"
                  ConfirmBusy="{Binding busy}"
                  CancelText="{Res admin.hol_cancel}"
                  HostStrings="true"
                  Title="{Binding title}"
                  Width="620"
                  Modal="true"
                  OnConfirm="floating_window_confirm"
                  OnClose="floating_window_close">
    <Stack Gap="16" Class="p-4">
      <!-- TODO(views-migrate): <TextField> autoFocus: no .kbview property -->
      <ReactHost Component="{Binding Part1}" Props="{Binding part1_props}"/>
      <Panel Class="grid gap-4 sm:grid-cols-2">
        <Stack Gap="4">
          <!-- TODO(views-migrate): <FieldLabel> is no .kbview element (../resources/FieldLabel#default) -->
          <ReactHost Component="{Binding Part2}" Props="{Binding part2_props}"/>
          <!-- TODO(views-migrate): <Dropdown> width, height, focusable: no .kbview property -->
          <ReactHost Component="{Binding Part3}" Props="{Binding part3_props}"/>
        </Stack>
        <Stack Gap="4">
          <!-- TODO(views-migrate): <FieldLabel> is no .kbview element (../resources/FieldLabel#default) -->
          <ReactHost Component="{Binding Part4}" Props="{Binding part2_props}"/>
          <!-- TODO(views-migrate): <Dropdown> width, height, focusable: no .kbview property -->
          <ReactHost Component="{Binding Part5}" Props="{Binding part5_props}"/>
        </Stack>
      </Panel>
      <Panel Visible="{Binding show_kind_fixed}" Class="grid gap-4 sm:grid-cols-2">
        <Stack Gap="4">
          <!-- TODO(views-migrate): <FieldLabel> is no .kbview element (../resources/FieldLabel#default) -->
          <ReactHost Component="{Binding Part6}" Props="{Binding part6_props}"/>
          <!-- TODO(views-migrate): <Dropdown> width, height, focusable: no .kbview property -->
          <ReactHost Component="{Binding Part7}" Props="{Binding part7_props}"/>
        </Stack>
        <NumericField Label="{Res admin.hol_field_day}"
                      Value="{Binding value}"
                      Minimum="1"
                      Maximum="31"
                      OnValueChanged="numeric_field_value_changed"/>
      </Panel>
      <Panel Visible="{Binding show_kind_easter}" Class="grid gap-4 sm:grid-cols-2">
        <NumericField Label="{Res admin.hol_field_offset}"
                      Value="{Binding value2}"
                      Minimum="{Binding minimum}"
                      Maximum="200"
                      Hint="{Res admin.hol_field_offset_hint}"
                      OnValueChanged="numeric_field_value_changed2"/>
        <Stack Gap="4">
          <!-- TODO(views-migrate): <FieldLabel> is no .kbview element (../resources/FieldLabel#default) -->
          <ReactHost Component="{Binding Part8}" Props="{Binding part8_props}"/>
          <!-- TODO(views-migrate): <Dropdown> width, height, focusable: no .kbview property -->
          <ReactHost Component="{Binding Part9}" Props="{Binding part9_props}"/>
        </Stack>
      </Panel>
      <Panel Visible="{Binding show_kind_nth_weekday}" Class="grid gap-4 sm:grid-cols-3">
        <Stack Gap="4">
          <!-- TODO(views-migrate): <FieldLabel> is no .kbview element (../resources/FieldLabel#default) -->
          <ReactHost Component="{Binding Part10}" Props="{Binding part10_props}"/>
          <!-- TODO(views-migrate): <Dropdown> width, height, focusable: no .kbview property -->
          <ReactHost Component="{Binding Part11}" Props="{Binding part11_props}"/>
        </Stack>
        <Stack Gap="4">
          <!-- TODO(views-migrate): <FieldLabel> is no .kbview element (../resources/FieldLabel#default) -->
          <ReactHost Component="{Binding Part12}" Props="{Binding part10_props}"/>
          <!-- TODO(views-migrate): <Dropdown> width, height, focusable: no .kbview property -->
          <ReactHost Component="{Binding Part13}" Props="{Binding part13_props}"/>
        </Stack>
        <Stack Gap="4">
          <!-- TODO(views-migrate): <FieldLabel> is no .kbview element (../resources/FieldLabel#default) -->
          <ReactHost Component="{Binding Part14}" Props="{Binding part10_props}"/>
          <!-- TODO(views-migrate): <Dropdown> width, height, focusable: no .kbview property -->
          <ReactHost Component="{Binding Part15}" Props="{Binding part15_props}"/>
        </Stack>
      </Panel>
      <Stack Gap="4" Visible="{Binding show_kind_dates}">
        <!-- TODO(views-migrate): <FieldLabel> is no .kbview element (../resources/FieldLabel#default) -->
        <ReactHost Component="{Binding Part16}" Props="{Binding part16_props}"/>
        <!-- TODO(views-migrate): <textarea> has no .kbview element yet -->
        <ReactHost Component="{Binding Part17}" Props="{Binding part17_props}"/>
        <Label Text="{Res admin.hol_field_dates_hint}"
               Overflow="Wrap"
               ForeColor="TextSecondary"
               InheritFontSize="true"
               Class="[font-size:var(--kb-text-small)]"/>
      </Stack>
      <Panel Class="grid gap-4 sm:grid-cols-3">
        <Stack Gap="4">
          <!-- TODO(views-migrate): <FieldLabel> is no .kbview element (../resources/FieldLabel#default) -->
          <ReactHost Component="{Binding Part18}" Props="{Binding part2_props}"/>
          <!-- TODO(views-migrate): <Dropdown> width, height, focusable: no .kbview property -->
          <ReactHost Component="{Binding Part19}" Props="{Binding part19_props}"/>
        </Stack>
        <!-- TODO(views-migrate): <TextField> inputMode: no .kbview property -->
        <ReactHost Component="{Binding Part20}" Props="{Binding part20_props}"/>
        <!-- TODO(views-migrate): <TextField> inputMode: no .kbview property -->
        <ReactHost Component="{Binding Part21}" Props="{Binding part21_props}"/>
      </Panel>
      <Panel BackColor="Surface1" Class="rounded border border-border p-3">
        <!-- TODO(views-migrate): <FieldLabel> is no .kbview element (../resources/FieldLabel#default) -->
        <ReactHost Component="{Binding Part22}" Props="{Binding part2_props}"/>
        <Label Text="{Res admin.hol_preview_none}"
               Overflow="Wrap"
               ForeColor="TextTertiary"
               InheritFontSize="true"
               Visible="{Binding show_preview}"
               Class="mt-1 [font-size:var(--kb-text-body)]"/>
        <Panel HtmlTag="Ul" Visible="{Binding show_not_preview}" Class="mt-1 flex flex-col gap-0.5">
          <Repeater ItemKey="key" ItemsSource="{Binding rows_preview}">
            <Panel HtmlTag="Li" ForeColor="TextPrimary" Class="[font-size:var(--kb-text-body)]">
              <Label HtmlTag="Span" InheritFontSize="true" Overflow="Wrap" Text="{Binding text}"/>
              <Label HtmlTag="Span"
                     Text="{Binding span_text}"
                     Overflow="Wrap"
                     ForeColor="TextSecondary"
                     InheritFontSize="true"
                     Visible="{Binding show_d_observed_from}"/>
            </Panel>
          </Repeater>
        </Panel>
      </Panel>
      <Callout Variant="Warning" Body="{Res admin.hol_detach_warning}" Visible="{Binding show_holiday_is_builtin}"/>
      <Label Text="{Binding error}"
             Overflow="Wrap"
             ForeColor="Danger"
             InheritFontSize="true"
             AccessibleRole="Alert"
             Visible="{Binding show_error}"
             Class="[font-size:var(--kb-text-body)]"/>
    </Stack>
  </FloatingWindow>
</Panel>
