<!-- ResourcesSection - converted from ResourcesSection.tsx by @kubuno/views-migrate (partial: see the TODO comments and the report). -->
<Stack x:Props="AdminSectionProps" Gap="16" Class="min-w-0">
  <Panel Class="min-w-0">
    <Label HtmlTag="H1"
           Text="{Res admin.nav_resources}"
           Overflow="Wrap"
           ForeColor="TextPrimary"
           InheritFontSize="true"
           Class="min-w-0 [font-size:var(--kb-text-page)]"/>
    <Label Text="{Res admin.res_intro}"
           Overflow="Wrap"
           ForeColor="TextSecondary"
           InheritFontSize="true"
           Class="mt-1 max-w-3xl [font-size:var(--kb-text-body)]"/>
  </Panel>
  <!-- TODO(views-migrate): <Tabs> tabs: no .kbview property -->
  <ReactHost Component="{Binding Part1}" Props="{Binding part1_props}"/>
  <OverviewTab OnGo="handleGo" Visible="{Binding show_pane_overview}"/>
  <BuildingsTab CanManage="{Binding canManage}" Visible="{Binding show_pane_buildings}"/>
  <ResourcesTab CanManage="{Binding canManage}" Visible="{Binding show_pane_resources}"/>
  <FeaturesTab CanManage="{Binding canManage}" Visible="{Binding show_pane_features}"/>
  <RoomStatsTab Visible="{Binding show_pane_room_stats}"/>
</Stack>
