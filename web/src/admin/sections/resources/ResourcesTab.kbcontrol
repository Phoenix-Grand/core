<!-- ResourcesTab — converted from ResourcesTab.tsx by @kubuno/views-migrate (partial: see the TODO comments and the report). -->
<UserControl x:Props="ResourcesTabProps">
  <Panel Class="min-w-0">
    <Label Text="{Binding error}"
           Overflow="Wrap"
           ForeColor="Danger"
           InheritFontSize="true"
           AccessibleRole="Alert"
           Visible="{Binding show_error}"
           Class="mb-3 [font-size:var(--kb-text-body)]"/>
    <!-- TODO(views-migrate): <DataTable> columns, rowKey, onRetry, rowActions, onRowClick, configurableColumns, t, toolbar, emptyState: no .kbview property -->
    <ReactHost Component="{Binding Part1}" Props="{Binding part1_props}"/>
    <!-- TODO(views-migrate): <ResourceDialog> is no .kbview element (./ResourceDialog#default) -->
    <ReactHost Component="{Binding ResourceDialog}" Props="{Binding resource_dialog_props}" Visible="{Binding show_editing}"/>
    <!-- TODO(views-migrate): <ConfirmDialog {...spread}> (spread props) -->
    <ReactHost Component="{Binding ConfirmDialog}" Props="{Binding confirm_dialog_props}" Visible="{Binding show_confirm_state}"/>
  </Panel>
</UserControl>
