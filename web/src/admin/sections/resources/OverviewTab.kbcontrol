<!-- OverviewTab — converted from OverviewTab.tsx by @kubuno/views-migrate (partial: see the TODO comments and the report). -->
<UserControl x:Props="OverviewTabProps">
  <Panel Class="contents">
    <Stack Direction="LeftToRight" Gap="0" Justify="Center" Visible="{Binding show_case_1}" Class="py-10">
      <Spinner/>
    </Stack>
    <Callout ActionLabel="{Res admin.res_retry}"
             Variant="Danger"
             Title="{Res admin.res_load_failed}"
             Visible="{Binding show_case_2}"
             OnAction="callout_action"/>
    <Stack Gap="20" Visible="{Binding show_main}" Class="min-w-0">
      <Panel Class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <!-- TODO(views-migrate): <Stat> is no .kbview element (a local or dynamic component) -->
        <ReactHost Component="{Binding Stat}" Props="{Binding stat_props}"/>
        <!-- TODO(views-migrate): <Stat> is no .kbview element (a local or dynamic component) -->
        <ReactHost Component="{Binding Stat}" Props="{Binding stat_props2}"/>
        <!-- TODO(views-migrate): <Stat> is no .kbview element (a local or dynamic component) -->
        <ReactHost Component="{Binding Stat}" Props="{Binding stat_props3}"/>
        <!-- TODO(views-migrate): <Stat> is no .kbview element (a local or dynamic component) -->
        <ReactHost Component="{Binding Stat}" Props="{Binding stat_props4}"/>
      </Panel>
      <Card Title="{Res admin.res_todo_title}" Subtitle="{Res admin.res_todo_subtitle}" Visible="{Binding show_is_empty}">
        <Panel Class="contents">
          <Label Text="{Res admin.res_todo_clear}"
                 Overflow="Wrap"
                 ForeColor="TextSecondary"
                 InheritFontSize="true"
                 Visible="{Binding show_gaps}"
                 Class="[font-size:var(--kb-text-body)]"/>
          <Panel HtmlTag="Ul" Visible="{Binding show_not_gaps}" Class="flex flex-col gap-2">
            <Repeater ItemKey="key" ItemsSource="{Binding rows_gaps}">
              <Panel HtmlTag="Li" Class="flex flex-wrap items-center justify-between gap-2">
                <Label HtmlTag="Span"
                       Text="{Binding g.text}"
                       Overflow="Wrap"
                       ForeColor="TextSecondary"
                       InheritFontSize="true"
                       Class="[font-size:var(--kb-text-body)]"/>
                <Button Variant="Ghost" Size="Sm" Text="{Res admin.res_todo_open}" OnClick="button_click"/>
              </Panel>
            </Repeater>
          </Panel>
        </Panel>
      </Card>
      <Card Title="{Res admin.res_order_title}" IconSize="16" Icon="Sparkles" Subtitle="{Res admin.res_order_subtitle}">
        <Panel HtmlTag="Ol" ForeColor="TextSecondary" Class="ml-4 flex list-decimal flex-col gap-1 [font-size:var(--kb-text-body)]">
          <Label HtmlTag="Li" Text="{Res admin.res_order_step_buildings}" Overflow="Wrap" InheritFontSize="true"/>
          <Label HtmlTag="Li" Text="{Res admin.res_order_step_features}" Overflow="Wrap" InheritFontSize="true"/>
          <Label HtmlTag="Li" Text="{Res admin.res_order_step_resources}" Overflow="Wrap" InheritFontSize="true"/>
        </Panel>
      </Card>
    </Stack>
  </Panel>
</UserControl>
