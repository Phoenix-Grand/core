<!-- ExportSubjectsCard — converted from ExportSubjectsCard.tsx by @kubuno/views-migrate (partial: see the TODO comments and the report). -->
<UserControl x:Props="ExportSubjectsCardProps">
  <Card Flush="true" Title="{Res admin.dx_sub_title}" Subtitle="{Res admin.dx_sub_desc}" Class="mt-4">
    <Card.Actions>
      <Button Size="Sm" Variant="Ghost" IconSize="15" Icon="X" Text="{Res common.close}" OnClick="button_click"/>
    </Card.Actions>
    <Panel Class="contents">
      <Stack Direction="LeftToRight" Gap="0" Justify="Center" Visible="{Binding isLoading}" Class="py-10">
        <Spinner/>
      </Stack>
      <Panel Visible="{Binding show_is_loading_is_error_data}" Class="p-4">
        <EmptyState ActionLabel="{Res admin.dx_retry}"
                    IconSize="26"
                    Icon="X"
                    Variant="Error"
                    Title="{Res admin.dx_sub_failed}"
                    Compact="true"
                    OnAction="empty_state_action"/>
      </Panel>
      <!-- TODO(views-migrate): <DataTable> columns, rowKey, defaultSort, minTableWidth, configurableColumns, t, emptyState: no .kbview property -->
      <ReactHost Component="{Binding Part1}" Props="{Binding part1_props}" Visible="{Binding show_is_loading_data}"/>
    </Panel>
  </Card>
</UserControl>
