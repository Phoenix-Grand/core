<!-- UnstoredFieldRow — converted from UnstoredFieldRow.tsx by @kubuno/views-migrate. -->
<UserControl x:Props="UnstoredFieldRowProps">
  <Stack Direction="LeftToRight" Gap="12" CrossAlign="Center" Class="py-3">
    <CheckBox Enabled="false" Text="{Binding text}" OnCheckedChanged="check_box_checked_changed"/>
    <Label HtmlTag="Span"
           Text="{Res admin.dirset_field_not_stored}"
           Overflow="Wrap"
           ForeColor="TextTertiary"
           BackColor="Surface2"
           InheritFontSize="true"
           Class="ml-auto shrink-0 rounded-full px-2 py-0.5 [font-size:var(--kb-text-micro)]"/>
  </Stack>
</UserControl>
