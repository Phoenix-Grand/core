<!-- ProfileTab — converted from ProfileTab.tsx by @kubuno/views-migrate (partial: see the TODO comments and the report). -->
<UserControl x:Props="ProfileTabProps">
  <Panel Class="grid gap-4 lg:grid-cols-2">
    <!-- TODO(views-migrate): <IdentityCard> is no .kbview element (./cards/IdentityCard#default) -->
    <ReactHost Component="{Binding IdentityCard}" Props="{Binding identity_card_props}"/>
    <!-- TODO(views-migrate): <OrganisationCard> is no .kbview element (./cards/OrganisationCard#default) -->
    <ReactHost Component="{Binding OrganisationCard}" Props="{Binding identity_card_props}"/>
    <!-- TODO(views-migrate): <PersonalCard> is no .kbview element (./cards/PersonalCard#default) -->
    <ReactHost Component="{Binding PersonalCard}" Props="{Binding identity_card_props}"/>
    <!-- TODO(views-migrate): <StorageCard> is no .kbview element (./cards/StorageCard#default) -->
    <ReactHost Component="{Binding StorageCard}" Props="{Binding identity_card_props}"/>
    <!-- TODO(views-migrate): <LifecycleCard> is no .kbview element (./cards/LifecycleCard#default) -->
    <ReactHost Component="{Binding LifecycleCard}" Props="{Binding identity_card_props}"/>
  </Panel>
</UserControl>
