<!-- DomainsSection - converted from DomainsSection.tsx by @kubuno/views-migrate (partial: see the TODO comments and the report). -->
<Panel x:Props="AdminSectionProps" Class="contents">
  <DomainDetail DomainId="{Binding domainId}" CanManage="{Binding canManage}" OnGone="handleGone" Visible="{Binding show_case_1}"/>
  <Stack Gap="16" Visible="{Binding show_main}" Class="min-w-0">
    <Panel Class="min-w-0">
      <Label HtmlTag="H1"
             Text="{Res admin.nav_domains}"
             Overflow="Wrap"
             ForeColor="TextPrimary"
             InheritFontSize="true"
             Class="min-w-0 [font-size:var(--kb-text-page)]"/>
      <Label Text="{Res admin.dom_intro}"
             Overflow="Wrap"
             ForeColor="TextSecondary"
             InheritFontSize="true"
             Class="mt-1 max-w-3xl [font-size:var(--kb-text-body)]"/>
    </Panel>
    <Stack Direction="LeftToRight"
           Gap="24"
           CrossAlign="Start"
           WrapContents="true"
           BackColor="Surface1"
           Visible="{Binding show_overview}"
           Class="rounded border border-border px-4 py-3">
      <!-- TODO(views-migrate): <Figure> is no .kbview element (a local or dynamic component) -->
      <ReactHost Component="{Binding Figure}" Props="{Binding figure_props}"/>
      <!-- TODO(views-migrate): <Figure> is no .kbview element (a local or dynamic component) -->
      <ReactHost Component="{Binding Figure}" Props="{Binding figure_props2}"/>
      <!-- TODO(views-migrate): <Figure> is no .kbview element (a local or dynamic component) -->
      <ReactHost Component="{Binding Figure}" Props="{Binding figure_props3}"/>
      <Stack Direction="LeftToRight" Gap="12" CrossAlign="Center" Class="ms-auto">
        <Label HtmlTag="Span"
               Text="{Res admin.dom_primary_is, Name={Binding dom_primary_is_name}}"
               Overflow="Wrap"
               ForeColor="TextSecondary"
               InheritFontSize="true"
               Visible="{Binding show_overview_primary_name}"
               Class="[font-size:var(--kb-text-small)]"/>
        <!-- TODO(views-migrate): <Button> with element children -->
        <ReactHost Component="{Binding Part1}" Props="{Binding part1_props}" Visible="{Binding canManage}"/>
      </Stack>
    </Stack>
    <Callout Body="{Res admin.dom_from_mismatch, Address={Binding dom_from_mismatch_address}, Domain={Binding dom_from_mismatch_domain}}"
             Visible="{Binding show_from_mismatch}"/>
    <Label Text="{Binding error}"
           Overflow="Wrap"
           ForeColor="Danger"
           InheritFontSize="true"
           AccessibleRole="Alert"
           Visible="{Binding show_error}"
           Class="[font-size:var(--kb-text-body)]"/>
    <!-- TODO(views-migrate): <DataTable> t, columns, rowKey, rowActions, onRowClick, onRetry, emptyState: no .kbview property -->
    <ReactHost Component="{Binding Part2}" Props="{Binding part2_props}"/>
    <!-- TODO(views-migrate): <AddDomainDialog> is no .kbview element (./AddDomainDialog#default) -->
    <ReactHost Component="{Binding AddDomainDialog}" Props="{Binding add_domain_dialog_props}" Visible="{Binding adding}"/>
  </Stack>
</Panel>
