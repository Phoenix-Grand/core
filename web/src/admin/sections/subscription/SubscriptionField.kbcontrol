<!-- Field — converted from Field.tsx by @kubuno/views-migrate (partial: see the TODO comments and the report). -->
<UserControl x:Props="FieldProps">
  <Panel Class="min-w-0">
    <Label HtmlTag="Div"
           Text="{Binding props.label}"
           Overflow="Wrap"
           ForeColor="TextTertiary"
           InheritFontSize="true"
           Class="[font-size:var(--kb-text-meta)]"/>
    <Panel Class="{Binding div_class}">
      <!-- TODO(views-migrate): elements held in an expression -->
      <ReactHost Component="{Binding Fragment}" Props="{Binding content_children}"/>
    </Panel>
  </Panel>
</UserControl>
