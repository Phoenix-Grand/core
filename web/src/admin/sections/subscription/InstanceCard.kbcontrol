<!-- InstanceCard — converted from InstanceCard.tsx by @kubuno/views-migrate (partial: see the TODO comments and the report). -->
<UserControl x:Props="InstanceCardProps">
  <Card Title="{Res admin.sub_instance_title}"
        IconSize="16"
        Icon="Building2"
        Subtitle="{Res admin.sub_instance_subtitle}">
    <Panel Class="contents">
      <Panel Class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <!-- TODO(views-migrate): <Field> is no .kbview element (./Field#default) -->
        <ReactHost Component="{Binding Part1}" Props="{Binding part1_props}"/>
        <!-- TODO(views-migrate): <Field> is no .kbview element (./Field#default) -->
        <ReactHost Component="{Binding Part2}" Props="{Binding part1_props}"/>
        <!-- TODO(views-migrate): <Field> is no .kbview element (./Field#default) -->
        <ReactHost Component="{Binding Part3}" Props="{Binding part3_props}"/>
        <!-- TODO(views-migrate): <Field> is no .kbview element (./Field#default) -->
        <ReactHost Component="{Binding Part4}" Props="{Binding part4_props}" Visible="{Binding show_accounts}"/>
      </Panel>
      <Panel Class="mt-4 border-t border-border pt-3">
        <!-- TODO(views-migrate): <Field> is no .kbview element (./Field#default) -->
        <ReactHost Component="{Binding Part5}" Props="{Binding part5_props}"/>
        <Label Text="{Res admin.sub_instance_id_hint}"
               Overflow="Wrap"
               ForeColor="TextTertiary"
               InheritFontSize="true"
               Class="mt-2 [font-size:var(--kb-text-meta)]"/>
      </Panel>
    </Panel>
  </Card>
</UserControl>
