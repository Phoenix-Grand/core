<!-- ScopeHeadline — converted from ScopeHeadline.tsx by @kubuno/views-migrate. -->
<UserControl x:Props="ScopeHeadlineProps">
  <Panel Class="mb-4 flex flex-wrap items-baseline gap-x-2 gap-y-1 border-b border-border pb-3">
    <Label HtmlTag="Span"
           Text="{Res admin.m_scope_applies_to}"
           Overflow="Wrap"
           ForeColor="TextSecondary"
           InheritFontSize="true"
           Class="[font-size:var(--kb-text-meta)]"/>
    <Label HtmlTag="Span"
           Text="{Binding span_text}"
           FontWeight="Medium"
           ForeColor="TextPrimary"
           InheritFontSize="true"
           Class="min-w-0 [font-size:var(--kb-text-body)]"/>
    <Label HtmlTag="Span"
           Text="{Binding span_text2}"
           ForeColor="TextTertiary"
           InheritFontSize="true"
           Visible="{Binding show_is_instance}"
           Class="min-w-0 [font-size:var(--kb-text-meta)]"/>
  </Panel>
</UserControl>
