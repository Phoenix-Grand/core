<!-- SettingSectionCard — converted from SettingSectionCard.tsx by @kubuno/views-migrate (partial: see the TODO comments and the report). -->
<UserControl x:Props="SettingSectionCardProps">
  <Panel HtmlTag="Section" Class="{Binding section_class}">
    <!-- TODO(views-migrate): <button aria-expanded aria-controls>: attribute(s) without a .kbview property -->
    <ReactHost Component="{Binding Part1}" Props="{Binding part1_props}"/>
    <!-- TODO(views-migrate): <div id>: attribute(s) without a .kbview property -->
    <ReactHost Component="{Binding Part2}" Props="{Binding part2_props}" Visible="{Binding props.open}"/>
  </Panel>
</UserControl>
