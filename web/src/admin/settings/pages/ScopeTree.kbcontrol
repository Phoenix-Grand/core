<!-- ScopeTree — converted from ScopeTree.tsx by @kubuno/views-migrate (partial: see the TODO comments and the report). -->
<UserControl x:Props="ScopeTreeProps">
  <Panel AccessibleName="{Res admin.m_scope_panel}">
    <Panel Visible="{Binding show_units_filter_threshold}" Class="px-2 pt-2">
      <!-- TODO(views-migrate): <TextField LeftIcon>: an icon size the element cannot take -->
      <ReactHost Component="{Binding Part1}" Props="{Binding part1_props}"/>
    </Panel>
    <Panel Class="max-h-[50vh] space-y-0.5 overflow-y-auto p-2">
      <!-- TODO(views-migrate): elements held in an expression -->
      <ReactHost Component="{Binding Fragment}" Props="{Binding content_instance_row}"/>
      <Label Text="{Res admin.ou_no_results}"
             Overflow="Wrap"
             ForeColor="TextTertiary"
             InheritFontSize="true"
             Visible="{Binding visible}"
             Class="px-2 py-2 [font-size:var(--kb-text-meta)]"/>
      <Repeater ItemKey="key" ItemsSource="{Binding rows_results}" Visible="{Binding visible2}">
        <Panel AccessibleRole="PushButton" AutoSize="true" Class="{Binding button_class}" OnClick="panel_click">
          <Panel HtmlTag="Span" Class="min-w-0 flex-1">
            <Label HtmlTag="Span" Text="{Binding u.name}" Class="block"/>
            <Label HtmlTag="Span"
                   Text="{Binding span_text}"
                   ForeColor="TextTertiary"
                   InheritFontSize="true"
                   Class="block [font-size:var(--kb-text-micro)]"/>
          </Panel>
        </Panel>
      </Repeater>
      <!-- TODO(views-migrate): a list callback destructuring its item -->
      <ReactHost Component="{Binding Part2}" Props="{Binding part2_props}" Visible="{Binding show_not_filtering}"/>
    </Panel>
    <Label Text="{Res admin.m_scope_panel_hint}"
           Overflow="Wrap"
           ForeColor="TextTertiary"
           InheritFontSize="true"
           Class="px-3 pb-2 leading-relaxed [font-size:var(--kb-text-micro)]"/>
  </Panel>
</UserControl>
