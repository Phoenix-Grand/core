<!-- SettingsSaveBar — converted from SettingsSaveBar.tsx by @kubuno/views-migrate (partial: see the TODO comments and the report). -->
<UserControl x:Props="SettingsSaveBarProps">
  <Panel Class="flex flex-wrap items-center justify-end gap-x-4 gap-y-2 border-t border-border px-5 py-3">
    <Panel HtmlTag="Span" Visible="{Binding show_blocked_elsewhere}" Class="{Binding span_class}">
      <Label HtmlTag="Span" InheritFontSize="true" Overflow="Wrap" Text="{Binding text}" Visible="{Binding blocked}"/>
      <Label HtmlTag="Span" InheritFontSize="true" Overflow="Wrap" Text="{Binding text2}" Visible="{Binding show_not_blocked}"/>
      <Panel HtmlTag="Span" Visible="{Binding visible}" Class="ml-2">
        <!-- TODO(views-migrate): elements held in an expression -->
        <ReactHost Component="{Binding Fragment}" Props="{Binding content_elsewhere_action}"/>
      </Panel>
    </Panel>
    <Stack Direction="LeftToRight" Gap="4" CrossAlign="Center" Class="shrink-0">
      <Panel AccessibleRole="PushButton" AutoSize="true" Class="{Binding button_class}" OnClick="panel_click">
        <Label HtmlTag="Span" InheritFontSize="true" Overflow="Wrap" Text="{Res common.cancel}"/>
      </Panel>
      <Panel AccessibleRole="PushButton"
             AutoSize="true"
             Enabled="{Binding enabled_unless_disabled}"
             Class="{Binding button_class2}"
             OnClick="panel_click2">
        <Label HtmlTag="Span" InheritFontSize="true" Overflow="Wrap" Text="{Binding text3}"/>
      </Panel>
    </Stack>
  </Panel>
</UserControl>
