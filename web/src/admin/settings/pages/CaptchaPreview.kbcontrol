<!-- CaptchaPreview — converted from CaptchaPreview.tsx by @kubuno/views-migrate (partial: see the TODO comments and the report). -->
<UserControl>
  <Panel BackColor="Surface1" DataAttributes="{Binding div_data}" Class="mt-2 rounded-lg border border-border p-3">
    <Stack Direction="LeftToRight" Gap="0" CrossAlign="Center" Justify="SpaceBetween" Class="mb-2">
      <Label HtmlTag="Span"
             Text="{Res admin.captcha_preview_title}"
             Overflow="Wrap"
             ForeColor="TextSecondary"
             InheritFontSize="true"
             Class="[font-size:var(--kb-text-meta)]"/>
      <Panel AccessibleRole="PushButton"
             AutoSize="true"
             Enabled="{Binding enabled_unless_is_fetching}"
             AccessibleName="{Res admin.captcha_preview_regen}"
             ToolTip="{Res admin.captcha_preview_regen}"
             Class="flex h-7 w-7 items-center justify-center rounded-full text-text-tertiary transition-colors hover:bg-surface-2 hover:text-text-secondary disabled:opacity-50"
             OnClick="panel_click">
        <!-- TODO(views-migrate): an icon with a computed className -->
        <ReactHost Component="{Binding Part1}" Props="{Binding part1_props}"/>
      </Panel>
    </Stack>
    <Label HtmlTag="Div"
           Text="{Res common.loading}"
           TextAlign="TopCenter"
           Overflow="Wrap"
           ForeColor="TextTertiary"
           InheritFontSize="true"
           Visible="{Binding show_c}"
           Class="py-4 [font-size:var(--kb-text-meta)]"/>
    <!-- TODO(views-migrate): <img> has no .kbview element yet -->
    <ReactHost Component="{Binding Part2}" Props="{Binding part2_props}" Visible="{Binding visible3}"/>
    <Panel BackColor="Surface"
           Visible="{Binding visible4}"
           Class="inline-flex items-center gap-2 rounded-md px-4 py-2 [border:1px_solid_var(--color-border)]">
      <Panel HtmlTag="Span" ForeColor="TextPrimary" Class="select-none whitespace-nowrap text-lg font-medium">
        <Label HtmlTag="Span" InheritFontSize="true" Overflow="Wrap" Text="{Binding text}"/>
        <Label HtmlTag="Span" InheritFontSize="true" Overflow="Wrap" Text=" = "/>
        <Label HtmlTag="Span" Text="?" Overflow="Wrap" ForeColor="TextTertiary" InheritFontSize="true"/>
      </Panel>
    </Panel>
    <Panel Visible="{Binding visible5}">
      <!-- TODO(views-migrate): <div> with a computed style -->
      <ReactHost Component="{Binding Part3}" Props="{Binding part3_props}"/>
      <Label Text="{Res admin.captcha_preview_slider_hint}"
             Overflow="Wrap"
             ForeColor="TextTertiary"
             InheritFontSize="true"
             Class="mt-1 [font-size:var(--kb-text-micro)]"/>
    </Panel>
  </Panel>
</UserControl>
