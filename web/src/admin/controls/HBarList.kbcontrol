<!-- HBarList — converted from HBarList.tsx by @kubuno/views-migrate (partial: see the TODO comments and the report). -->
<UserControl x:Props="HBarListProps">
  <Panel HtmlTag="Ul" Class="space-y-3">
    <Repeater ItemKey="key" ItemsSource="{Binding rows_items}">
      <Panel HtmlTag="Li" Class="group">
        <Stack Direction="LeftToRight" Gap="0" CrossAlign="Center" Justify="SpaceBetween" Class="text-sm mb-1">
          <Label HtmlTag="Span"
                 Text="{Binding it.label}"
                 ForeColor="TextSecondary"
                 InheritFontSize="true"
                 Class="flex-1 mr-2 group-hover:text-text-primary transition-colors"/>
          <Label HtmlTag="Span" Text="{Binding it.sub}" Overflow="Wrap" ForeColor="TextTertiary" InheritFontSize="true" Class="tabular-nums"/>
        </Stack>
        <Panel BackColor="Surface2" ToolTip="{Binding tooltip}" Class="h-2 rounded-full overflow-hidden">
          <!-- TODO(views-migrate): <div> with a computed style -->
          <ReactHost Component="{Binding Part1}" Props="{Binding part1_props}"/>
        </Panel>
      </Panel>
    </Repeater>
  </Panel>
</UserControl>
