<!-- DonutChart — converted from DonutChart.tsx by @kubuno/views-migrate (partial: see the TODO comments and the report). -->
<UserControl x:Props="DonutChartProps">
  <Stack Direction="LeftToRight" Gap="16" CrossAlign="Center">
    <!-- TODO(views-migrate): <div> with a computed style -->
    <ReactHost Component="{Binding Part1}" Props="{Binding part1_props}"/>
    <Panel HtmlTag="Ul" Class="flex-1 min-w-0 space-y-1">
      <Repeater ItemKey="key" ItemsSource="{Binding rows_data}">
        <Panel HtmlTag="Li" Class="{Binding li_class}" OnMouseEnter="panel_mouse_enter" OnMouseLeave="panel_mouse_leave">
          <!-- TODO(views-migrate): <span> with a computed style -->
          <ReactHost Component="{Binding Part2}" Props="{Binding part2_props}"/>
          <Label HtmlTag="Span" Text="{Binding d.label}" ForeColor="TextSecondary" InheritFontSize="true" Class="flex-1"/>
          <Label HtmlTag="Span"
                 Text="{Binding d.value}"
                 FontWeight="Medium"
                 Overflow="Wrap"
                 ForeColor="TextPrimary"
                 InheritFontSize="true"
                 Class="tabular-nums"/>
          <Label HtmlTag="Span"
                 Text="{Binding span_text}"
                 Overflow="Wrap"
                 ForeColor="TextTertiary"
                 InheritFontSize="true"
                 Class="tabular-nums w-9 text-right"/>
        </Panel>
      </Repeater>
    </Panel>
  </Stack>
</UserControl>
