<!-- OrgUnitScopePanel — converted from OrgUnitScopePanel.tsx by @kubuno/views-migrate (partial: see the TODO comments and the report). -->
<UserControl x:Props="Props">
  <Panel Class="contents">
    <Stack CrossAlign="Center"
           Visible="{Binding show_case_1}"
           Class="sticky top-[52px] self-start shrink-0 w-11 bg-white rounded-xl border border-border py-3">
      <Panel AccessibleRole="PushButton"
             AutoSize="true"
             ForeColor="TextSecondary"
             ToolTip="{Res admin.nav_org_units}"
             AccessibleName="{Res admin.nav_org_units}"
             Class="w-8 h-8 rounded-full flex items-center justify-center hover:bg-surface-2"
             OnClick="panel_click">
        <Icon Name="ChevronRight" Size="16"/>
      </Panel>
      <Icon Name="Building2" Size="16" Class="text-text-tertiary"/>
    </Stack>
    <Stack Gap="0"
           Visible="{Binding show_main}"
           Class="sticky top-[52px] self-start shrink-0 w-[300px] bg-white rounded-xl border border-border max-h-[calc(100vh-160px)]">
      <Stack Direction="LeftToRight" Gap="0" CrossAlign="Center" Justify="SpaceBetween" Class="px-4 py-3 border-b border-border">
        <Label HtmlTag="H2" Text="{Res admin.nav_org_units}" FontWeight="Medium" ForeColor="TextPrimary"/>
        <Panel AccessibleRole="PushButton"
               AutoSize="true"
               ForeColor="TextSecondary"
               ToolTip="{Res admin.ou_panel_collapse}"
               AccessibleName="{Res admin.ou_panel_collapse}"
               Class="w-7 h-7 shrink-0 rounded-full flex items-center justify-center hover:bg-surface-2"
               OnClick="panel_click2">
          <Icon Name="ChevronLeft" Size="16"/>
        </Panel>
      </Stack>
      <Stack Class="px-4 py-3 border-b border-border">
        <RadioButton SelectedValue="{Binding selected_value}"
                     Value="true"
                     Text="{Res admin.filter_ou_all}"
                     OnCheckedChanged="radio_button_checked_changed"/>
        <RadioButton SelectedValue="{Binding selected_value2}"
                     Value="true"
                     Text="{Res admin.ou_scope_selected}"
                     OnCheckedChanged="radio_button_checked_changed2"/>
      </Stack>
      <Panel Class="px-3 pt-3">
        <TextField Text="{Binding needle, Mode=TwoWay}" InputType="Search" Placeholder="{Res admin.ou_search_ph}"/>
      </Panel>
      <Panel Class="px-3 pt-3">
        <Stack Direction="LeftToRight" Gap="0" Class="rounded-lg border border-border overflow-hidden text-sm">
          <Repeater ItemKey="key" ItemsSource="{Binding rows_items}">
            <Panel AccessibleRole="PushButton" AutoSize="true" Class="{Binding button_class}" OnClick="panel_click3">
              <Label HtmlTag="Span" InheritFontSize="true" Overflow="Wrap" Text="{Binding text}"/>
            </Panel>
          </Repeater>
        </Stack>
      </Panel>
      <Panel AccessibleRole="Outline" AccessibleName="{Res admin.nav_org_units}" Class="px-3 py-3 flex-1 min-h-0 overflow-y-auto">
        <Label Text="{Res admin.ou_no_results}" Overflow="Wrap" ForeColor="TextTertiary" Visible="{Binding show_rows}" Class="px-1 py-2"/>
        <Panel>
          <!-- TODO(views-migrate): a list callback destructuring its item -->
          <ReactHost Component="{Binding Part1}" Props="{Binding part1_props}"/>
        </Panel>
      </Panel>
      <Panel Visible="{Binding show_value_mode_selected}" Class="px-4 pb-3">
        <!-- TODO(views-migrate): <CheckBox> labelClassName: no .kbview property -->
        <ReactHost Component="{Binding Part2}" Props="{Binding part2_props}"/>
      </Panel>
      <Panel Class="mt-auto border-t border-border px-4 py-3">
        <LinkLabel Href="{Binding href}"
                   Text="{Res admin.ou_manage_title}"
                   FontWeight="Medium"
                   ForeColor="Primary"
                   Class="hover:underline"
                   OnClick="link_label_click"/>
      </Panel>
    </Stack>
  </Panel>
</UserControl>
