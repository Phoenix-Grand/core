<!-- CategoryRows — converted from CategoryRows.tsx by @kubuno/views-migrate (partial: see the TODO comments and the report). -->
<UserControl x:Props="CategoryRowsProps">
  <Panel Class="contents">
    <Label Text="{Res admin.sto_cat_empty}"
           Overflow="Wrap"
           ForeColor="TextTertiary"
           InheritFontSize="true"
           Visible="{Binding show_case_1}"
           Class="py-2 [font-size:var(--kb-text-meta)]"/>
    <Panel HtmlTag="Ul" Visible="{Binding show_main}" Class="flex flex-col divide-y divide-border">
      <Repeater ItemKey="key" ItemsSource="{Binding rows_held}">
        <!-- TODO(views-migrate): <CategoryRow> is no .kbview element (a local or dynamic component) -->
        <ReactHost Component="{Binding CategoryRow}" Props="{Binding category_row_props}"/>
      </Repeater>
    </Panel>
  </Panel>
</UserControl>
