<!-- CategoryComposition — converted from CategoryComposition.tsx by @kubuno/views-migrate (partial: see the TODO comments and the report). -->
<UserControl x:Props="CategoryCompositionProps">
  <Panel>
    <CompositionBar Segments="{Binding segments}" Total="{Binding cc_total}" AriaLabel="{Binding props.ariaLabel}" Visible="{Binding show_segments}"/>
    <Label Text="{Res admin.sto_cat_empty}"
           Overflow="Wrap"
           ForeColor="TextTertiary"
           InheritFontSize="true"
           Visible="{Binding show_not_segments}"
           Class="[font-size:var(--kb-text-body)]"/>
    <Label Text="{Res admin.sto_cat_split, Billed={Binding sto_cat_split_billed}, NotBilled={Binding sto_cat_split_not_billed}}"
           Overflow="Wrap"
           ForeColor="TextSecondary"
           InheritFontSize="true"
           Visible="{Binding show_segments}"
           Class="mt-3 [font-size:var(--kb-text-meta)]"/>
    <Panel HtmlTag="Ul" Visible="{Binding show_segments}" Class="mt-2 flex flex-col divide-y divide-border border-t border-border">
      <Repeater ItemKey="key" ItemsSource="{Binding rows_slices}">
        <!-- TODO(views-migrate): <CategoryRow> is no .kbview element (a local or dynamic component) -->
        <ReactHost Component="{Binding CategoryRow}" Props="{Binding category_row_props}"/>
      </Repeater>
    </Panel>
    <!-- TODO(views-migrate): <Callout> icon: a value the property converts (null-when-false) -->
    <ReactHost Component="{Binding Part1}" Props="{Binding part1_props}" Visible="{Binding show_reading_trash}"/>
    <DelegatedNote Bytes="{Binding props.delegatedBytes}" Objects="{Binding props.delegatedObjects}" ClassName="mt-4"/>
  </Panel>
</UserControl>
