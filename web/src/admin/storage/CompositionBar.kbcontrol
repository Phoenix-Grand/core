<!-- CompositionBar — converted from CompositionBar.tsx by @kubuno/views-migrate (partial: see the TODO comments and the report). -->
<UserControl x:Props="CompositionBarProps">
  <Panel>
    <Stack Direction="LeftToRight"
           Gap="0"
           BackColor="Surface2"
           AccessibleRole="Graphic"
           AccessibleName="{Binding props.ariaLabel}"
           Class="h-3 w-full overflow-hidden rounded-full">
      <Repeater ItemKey="key" ItemsSource="{Binding rows_visible}">
        <!-- TODO(views-migrate): <div> with a computed style -->
        <ReactHost Component="{Binding Part1}" Props="{Binding part1_props}"/>
      </Repeater>
    </Stack>
    <Panel HtmlTag="Ul" Class="mt-3 flex flex-wrap gap-x-5 gap-y-2">
      <Repeater ItemKey="key" ItemsSource="{Binding rows_segments}">
        <Panel HtmlTag="Li" Class="flex min-w-0 items-center gap-2">
          <!-- TODO(views-migrate): <span> with a computed style -->
          <ReactHost Component="{Binding Part2}" Props="{Binding part2_props}"/>
          <Label HtmlTag="Span"
                 Text="{Binding s.label}"
                 ForeColor="TextSecondary"
                 InheritFontSize="true"
                 Class="min-w-0 [font-size:var(--kb-text-body)]"/>
          <Label HtmlTag="Span"
                 Text="{Binding span_text}"
                 Overflow="Wrap"
                 ForeColor="TextPrimary"
                 InheritFontSize="true"
                 Class="shrink-0 tabular-nums [font-size:var(--kb-text-body)]"/>
        </Panel>
      </Repeater>
    </Panel>
  </Panel>
</UserControl>
