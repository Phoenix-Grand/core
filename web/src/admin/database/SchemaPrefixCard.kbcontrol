<!-- SchemaPrefixCard — converted from SchemaPrefixCard.tsx by @kubuno/views-migrate (partial: see the TODO comments and the report). -->
<UserControl>
  <Card Title="{Res admin.dbprefix_title}"
        IconSize="16"
        Icon="Database"
        Subtitle="{Res admin.dbprefix_subtitle}"
        Visible="{Binding show_main}"
        Class="mb-4">
    <Panel Class="contents">
      <Stack Direction="LeftToRight" Gap="0" Justify="Center" Visible="{Binding cfg.isLoading}" Class="py-6">
        <Spinner/>
      </Stack>
      <!-- TODO(views-migrate): <Callout> icon: a value the property converts (null-when-false) -->
      <ReactHost Component="{Binding Part1}" Props="{Binding part1_props}" Visible="{Binding visible}"/>
      <Stack Gap="16" Visible="{Binding visible2}">
        <Callout Body="{Res admin.dbprefix_sqlite_na}" Visible="{Binding show_applicable}"/>
        <Callout Variant="Danger" Title="{Res admin.dbprefix_error}" Body="{Binding error}" Visible="{Binding show_error}"/>
        <!-- TODO(views-migrate): <Callout> with element children -->
        <ReactHost Component="{Binding Part2}" Props="{Binding part2_props}" Visible="{Binding show_done}"/>
        <Panel>
          <!-- TODO(views-migrate): <OutlinedField> is no .kbview element (@ui#OutlinedField) -->
          <ReactHost Component="{Binding OutlinedField}" Props="{Binding outlined_field_props}"/>
          <Label Text="{Res admin.dbprefix_hint}"
                 Overflow="Wrap"
                 ForeColor="TextTertiary"
                 InheritFontSize="true"
                 Class="mt-1 [font-size:var(--kb-text-meta)]"/>
        </Panel>
        <Panel>
          <Button Size="Sm"
                  Loading="{Binding saveMut.isPending}"
                  Enabled="{Binding enabled_unless_applicable_save_mut_is_pending}"
                  Text="{Res admin.dbprefix_apply}"
                  OnClick="onSave"/>
        </Panel>
      </Stack>
      <!-- TODO(views-migrate): <ConfirmDialog {...spread}> (spread props) -->
      <ReactHost Component="{Binding ConfirmDialog}" Props="{Binding confirm_dialog_props}" Visible="{Binding show_confirm_state}"/>
    </Panel>
  </Card>
</UserControl>
