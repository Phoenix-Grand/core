<!-- HomePage - converted from HomePage.tsx by @kubuno/views-migrate (partial: see the TODO comments and the report). -->
<Panel Class="contents">
  <Stack Gap="16" CrossAlign="Center" Justify="Center" Visible="{Binding show_case_1}" Class="py-32 text-center">
    <Stack Direction="LeftToRight" Gap="0" CrossAlign="Center" Justify="Center" BackColor="Surface2" Class="w-20 h-20 rounded-3xl">
      <Icon Name="LayoutDashboard" Size="40" Class="text-text-tertiary"/>
    </Stack>
    <Panel>
      <Label HtmlTag="H1" Text="{Res home.welcome_title}" FontWeight="Medium" Overflow="Wrap" ForeColor="TextPrimary" Class="text-xl mb-2"/>
      <Panel HtmlTag="P" ForeColor="TextSecondary" Class="text-sm max-w-xs mx-auto">
        <Label HtmlTag="Span" InheritFontSize="true" Overflow="Wrap" Text="{Res home.no_module_pre}"/>
        <LinkLabel Href="/admin"
                   Text="{Res home.admin_link}"
                   ForeColor="Primary"
                   InheritFontSize="true"
                   Class="hover:underline"
                   OnClick="link_label_click"/>
        <Label HtmlTag="Span" InheritFontSize="true" Overflow="Wrap" Text="."/>
      </Panel>
    </Panel>
  </Stack>
  <Panel Visible="{Binding show_main}">
    <Stack Direction="LeftToRight" Gap="16" CrossAlign="Center" Justify="SpaceBetween" Class="mb-6">
      <Panel Class="shrink-0">
        <Label HtmlTag="H1" Text="{Binding h1_text}" FontWeight="Medium" Overflow="Wrap" ForeColor="TextPrimary" Class="text-xl"/>
        <Label Text="{Binding p_text}" Overflow="Wrap" ForeColor="TextTertiary" Class="mt-0.5 capitalize"/>
      </Panel>
      <Stack Direction="LeftToRight"
             Gap="6"
             CrossAlign="Center"
             Justify="Center"
             Visible="{Binding show_edit_mode_is_mobile_fav_apps}"
             Class="flex-1 min-w-0 overflow-x-auto no-scrollbar">
        <Repeater ItemKey="key" ItemsSource="{Binding rows_fav_apps}">
          <Panel Href="{Binding href}"
                 ToolTip="{Binding app.label}"
                 AccessibleName="{Binding app.label}"
                 Class="group flex flex-col items-center justify-center w-20 shrink-0 gap-1 py-1.5 rounded-xl hover:bg-surface-2 transition-colors"
                 OnClick="panel_click">
            <!-- TODO(views-migrate): <app.Icon> is no .kbview element (a local or dynamic component) -->
            <ReactHost Component="{Binding Part1}" Props="{Binding part1_props}"/>
            <Label HtmlTag="Span"
                   Text="{Binding app.label}"
                   ForeColor="TextTertiary"
                   Class="text-[10px] leading-tight group-hover:text-text-secondary max-w-full"/>
          </Panel>
        </Repeater>
      </Stack>
      <Button Size="Sm" IconSize="14" Icon="Check" Text="{Res home.finish}" Visible="{Binding editMode}" OnClick="button_click"/>
      <Button Size="Sm"
              Variant="Secondary"
              IconSize="14"
              Icon="Pencil"
              Text="{Res home.customize}"
              Visible="{Binding show_not_edit_mode}"
              OnClick="button_click2"/>
    </Stack>
    <!-- TODO(views-migrate): <GridDashboard> is no .kbview element (../widgets/GridDashboard#default) -->
    <ReactHost Component="{Binding GridDashboard}" Props="{Binding grid_dashboard_props}"/>
  </Panel>
</Panel>
