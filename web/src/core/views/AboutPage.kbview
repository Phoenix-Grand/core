<!-- AboutPage - converted from AboutPage.tsx by @kubuno/views-migrate (partial: see the TODO comments and the report). -->
<Panel Class="max-w-2xl">
  <Label HtmlTag="H1" Text="{Res about.title}" FontWeight="Medium" Overflow="Wrap" ForeColor="TextPrimary" Class="text-xl mb-6"/>
  <Stack Gap="16" CrossAlign="Center" Class="bg-white rounded-2xl border border-border p-8 mb-6 text-center">
    <Stack Direction="LeftToRight" Gap="0" CrossAlign="Center" Justify="Center" BackColor="PrimaryLight" Class="w-20 h-20 rounded-3xl">
      <!-- TODO(views-migrate): <Cloud strokeWidth>: an icon attribute without a property -->
      <ReactHost Component="{Binding Part1}"/>
    </Stack>
    <Panel>
      <Label HtmlTag="H2" Text="Kubuno" FontWeight="SemiBold" Overflow="Wrap" ForeColor="TextPrimary" Class="text-2xl"/>
      <Label Text="{Binding p_text}" Overflow="Wrap" ForeColor="TextTertiary" Class="mt-0.5"/>
    </Panel>
    <Label Text="{Res about.description}" Overflow="Wrap" ForeColor="TextSecondary" Class="max-w-md"/>
  </Stack>
  <Panel Class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-6">
    <!-- TODO(views-migrate): a list callback destructuring its item -->
    <ReactHost Component="{Binding Part2}" Props="{Binding part2_props}"/>
  </Panel>
  <Stack Direction="LeftToRight" Gap="12" CrossAlign="Center" Class="bg-white rounded-xl border border-border p-4">
    <!-- TODO(views-migrate): <GithubMark> is no .kbview element (a local or dynamic component) -->
    <ReactHost Component="{Binding GithubMark}" Props="{Binding github_mark_props}"/>
    <Panel>
      <Label Text="{Res about.source}" Role="Meta" Overflow="Wrap" ForeColor="TextTertiary" Class="mb-0.5"/>
      <!-- TODO(views-migrate): <a target rel>: attribute(s) without a .kbview property -->
      <ReactHost Component="{Binding Part3}"/>
    </Panel>
  </Stack>
</Panel>
