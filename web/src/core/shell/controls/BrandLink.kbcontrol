<!-- BrandLink - converted from BrandLink.tsx by @kubuno/views-migrate (partial: see the TODO comments and the report). -->
<UserControl x:Props="BrandLinkProps">
  <Panel Href="{Binding to}" ToolTip="{Binding label}" OnClick="panel_click">
    <!-- TODO(views-migrate): <Icon> is no .kbview element (a local or dynamic component) -->
    <ReactHost Component="{Binding Part1}" Props="{Binding part1_props}" Visible="{Binding show_icon}"/>
    <!-- TODO(views-migrate): <InstanceLogo> is no .kbview element (./InstanceLogo#InstanceLogo) -->
    <ReactHost Component="{Binding InstanceLogo}" Props="{Binding instance_logo_props}" Visible="{Binding show_not_icon}"/>
    <Label HtmlTag="Span"
           Text="{Binding label}"
           FontWeight="Regular"
           Overflow="Wrap"
           Visible="{Binding show_collapsed}"
           Class="text-[22px] hidden sm:block whitespace-nowrap [color:#5f6368] [letter-spacing:-0.01em]"/>
  </Panel>
</UserControl>
