<!-- HeaderActions - converted from HeaderActions.tsx by @kubuno/views-migrate (partial: see the TODO comments and the report). -->
<UserControl x:Props="HeaderActionsProps">
  <Stack Direction="LeftToRight" Gap="0" CrossAlign="Center" Class="flex-shrink-0">
    <!-- TODO(views-migrate): <Slot> is no .kbview element (../slots/SlotRegistry#Slot) -->
    <ReactHost Component="{Binding Slot}" Props="{Binding slot_props}" Visible="{Binding show_minimal}"/>
    <!-- TODO(views-migrate): <Slot> is no .kbview element (../slots/SlotRegistry#Slot) -->
    <ReactHost Component="{Binding Slot}" Props="{Binding slot_props2}" Visible="{Binding show_minimal}"/>
    <!-- TODO(views-migrate): <DropdownMenu.Root> is no .kbview element (a local or dynamic component) -->
    <ReactHost Component="{Binding Part1}" Props="{Binding part1_props}" Visible="{Binding show_minimal}"/>
    <!-- TODO(views-migrate): <SettingsButtonOverride> is no .kbview element (a local or dynamic component) -->
    <ReactHost Component="{Binding Part2}" Props="{Binding part2_props}" Visible="{Binding visible3}"/>
    <!-- TODO(views-migrate): <SettingsMenu> is no .kbview element (./SettingsMenu#default) -->
    <ReactHost Component="{Binding SettingsMenu}" Props="{Binding settings_menu_props}" Visible="{Binding visible4}"/>
    <!-- TODO(views-migrate): <DropdownMenu.Root> is no .kbview element (a local or dynamic component) -->
    <ReactHost Component="{Binding Part3}" Props="{Binding part3_props}" Visible="{Binding show_minimal}"/>
    <Panel Class="hidden lg:block">
      <!-- TODO(views-migrate): <WaffleButton> is no .kbview element (./menus/WaffleButton#default) -->
      <ReactHost Component="{Binding WaffleButton}" Props="{Binding waffle_button_props}"/>
    </Panel>
    <!-- TODO(views-migrate): <AccountButton> is no .kbview element (./menus/AccountButton#default) -->
    <ReactHost Component="{Binding AccountButton}" Props="{Binding account_button_props}"/>
    <!-- TODO(views-migrate): <AddAccountModal> is no .kbview element (../components/AddAccountModal#default) -->
    <ReactHost Component="{Binding AddAccountModal}" Props="{Binding add_account_modal_props}"/>
  </Stack>
</UserControl>
