<!-- RightRail - converted from RightRail.tsx by @kubuno/views-migrate (partial: see the TODO comments and the report). -->
<UserControl>
  <Panel Class="contents">
    <Stack Gap="2"
           CrossAlign="Center"
           BackColor="Background"
           Visible="{Binding show_main}"
           Class="relative z-50 w-14 flex-shrink-0 rounded-xl py-2">
      <!-- TODO(views-migrate): a list callback destructuring its item -->
      <ReactHost Component="{Binding Part1}" Props="{Binding part1_props}"/>
      <!-- TODO(views-migrate): <ToolTip> label, side: no .kbview property -->
      <ReactHost Component="{Binding Part2}" Props="{Binding part2_props}" Visible="{Binding show_reopen_entries}"/>
      <!-- TODO(views-migrate): <ToolTip> label, side: no .kbview property -->
      <ReactHost Component="{Binding Part3}" Props="{Binding part3_props}" Visible="{Binding show_visible}"/>
    </Stack>
    <!-- TODO(views-migrate): <RightRailCustomize> is no .kbview element (./RightRailCustomize#default) -->
    <ReactHost Component="{Binding RightRailCustomize}" Props="{Binding right_rail_customize_props}" Visible="{Binding visible2}"/>
    <!-- TODO(views-migrate): <ContextMenu> pos, onClose: no .kbview property -->
    <ReactHost Component="{Binding Part4}" Props="{Binding part4_props}" Visible="{Binding visible3}"/>
  </Panel>
</UserControl>
