<!-- Field - converted from Field.tsx by @kubuno/views-migrate (partial: see the TODO comments and the report). -->
<UserControl x:Props="FieldProps">
  <Panel Class="{Binding props.className}">
    <Stack Direction="LeftToRight" Gap="6" CrossAlign="Center" Class="mb-1">
      <Label HtmlTag="Label" Text="{Binding props.label}" FontWeight="Medium" Overflow="Wrap" ForeColor="TextPrimary"/>
      <VisToggle Value="{Binding visValue}" OnChange="vis_change" Visible="{Binding show_vis_on_vis}"/>
      <Panel HtmlTag="Span" Visible="{Binding show_action}" Class="ml-auto">
        <!-- TODO(views-migrate): elements held in an expression -->
        <ReactHost Component="{Binding Fragment}" Props="{Binding content_action}"/>
      </Panel>
    </Stack>
    <!-- TODO(views-migrate): elements held in an expression -->
    <ReactHost Component="{Binding Fragment}" Props="{Binding content_children}"/>
    <Panel ForeColor="TextTertiary" Visible="{Binding show_hint}" Class="text-xs mt-1 leading-relaxed">
      <!-- TODO(views-migrate): elements held in an expression -->
      <ReactHost Component="{Binding Fragment}" Props="{Binding content_hint}"/>
    </Panel>
  </Panel>
</UserControl>
