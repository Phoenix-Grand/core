<!-- ClientsTab - converted from ClientsTab.tsx by @kubuno/views-migrate (partial: see the TODO comments and the report). -->
<UserControl>
  <Panel Class="max-w-3xl space-y-10">
    <Panel HtmlTag="Section">
      <Label HtmlTag="H2"
             Text="{Res settings.cli_apps_title}"
             FontWeight="SemiBold"
             Overflow="Wrap"
             ForeColor="TextPrimary"
             Class="text-lg mb-2"/>
      <Label Text="{Res settings.cli_apps_desc}" Overflow="Wrap" ForeColor="TextSecondary" Class="mb-4 leading-relaxed"/>
      <Stack Direction="LeftToRight" Gap="12" WrapContents="true">
        <!-- TODO(views-migrate): <StoreBadge> is no .kbview element (a local or dynamic component) -->
        <ReactHost Component="{Binding StoreBadge}" Props="{Binding store_badge_props}"/>
        <!-- TODO(views-migrate): <StoreBadge> is no .kbview element (a local or dynamic component) -->
        <ReactHost Component="{Binding StoreBadge}" Props="{Binding store_badge_props2}"/>
        <!-- TODO(views-migrate): <StoreBadge> is no .kbview element (a local or dynamic component) -->
        <ReactHost Component="{Binding StoreBadge}" Props="{Binding store_badge_props3}"/>
        <!-- TODO(views-migrate): <StoreBadge> is no .kbview element (a local or dynamic component) -->
        <ReactHost Component="{Binding StoreBadge}" Props="{Binding store_badge_props4}"/>
      </Stack>
      <Panel HtmlTag="P" ForeColor="TextTertiary" Class="text-xs mt-4 leading-relaxed">
        <Label HtmlTag="Span" InheritFontSize="true" Overflow="Wrap" Text="{Res settings.cli_apps_token}"/>
        <Label HtmlTag="Span" InheritFontSize="true" Overflow="Wrap" Text=" "/>
        <LinkLabel Href="/settings?tab=api-tokens"
                   Text="{Res settings.cli_apps_token_link}"
                   ForeColor="Primary"
                   InheritFontSize="true"
                   Class="hover:underline"
                   OnClick="link_label_click"/>
      </Panel>
    </Panel>
    <Panel HtmlTag="Section" Visible="{Binding show_connectors}">
      <Label HtmlTag="H2"
             Text="{Res settings.cli_connect_title}"
             FontWeight="SemiBold"
             Overflow="Wrap"
             ForeColor="TextPrimary"
             Class="text-lg mb-2"/>
      <Label Text="{Res settings.cli_connect_desc}" Overflow="Wrap" ForeColor="TextSecondary" Class="mb-4 leading-relaxed"/>
      <Stack Direction="LeftToRight" Gap="12" WrapContents="true">
        <Repeater ItemKey="key" ItemsSource="{Binding rows_connectors}">
          <Panel Href="{Binding c.to}"
                 ForeColor="TextPrimary"
                 Class="inline-flex items-center gap-2 rounded-lg bg-surface-1 hover:bg-surface-2 border border-border px-4 py-2.5 text-sm font-medium transition-colors"
                 OnClick="panel_click">
            <Icon Name="{Binding icon}" Size="16" Class="text-primary"/>
            <Label HtmlTag="Span" InheritFontSize="true" Overflow="Wrap" Text="{Binding text}"/>
          </Panel>
        </Repeater>
      </Stack>
    </Panel>
    <Panel HtmlTag="Section">
      <Label HtmlTag="H2"
             Text="{Res settings.cli_server_title}"
             FontWeight="SemiBold"
             Overflow="Wrap"
             ForeColor="TextPrimary"
             Class="text-lg mb-2"/>
      <Label Text="{Res settings.cli_server_desc}" Overflow="Wrap" ForeColor="TextSecondary" Class="mb-3 leading-relaxed"/>
      <Stack Direction="LeftToRight" CrossAlign="Center" Class="max-w-md">
        <Panel Class="flex-1">
          <TextField ReadOnly="true" Text="{Binding serverUrl}"/>
        </Panel>
        <Panel AccessibleRole="PushButton"
               AutoSize="true"
               ForeColor="TextSecondary"
               ToolTip="{Res settings.cli_copy}"
               Class="p-2.5 rounded-lg border border-border hover:bg-surface-2 transition-colors"
               OnClick="copy">
          <Icon Name="Check" Size="16" Visible="{Binding copied}" Class="text-success"/>
          <Icon Name="Copy" Size="16" Visible="{Binding show_not_copied}"/>
        </Panel>
      </Stack>
    </Panel>
  </Panel>
</UserControl>
