<!-- TwoFactorSection — converted from TwoFactorSection.tsx by @kubuno/views-migrate (partial: see the TODO comments and the report). -->
<UserControl>
  <Panel Class="contents">
    <Panel Visible="{Binding show_case_1}" Class="space-y-3">
      <Label HtmlTag="H3" Text="{Res settings.tfa_title}" FontWeight="Medium" Overflow="Wrap" ForeColor="TextPrimary"/>
      <Stack Direction="LeftToRight" Gap="12" CrossAlign="Center" BackColor="SuccessLight" Class="px-4 py-3 rounded-lg border border-success">
        <Icon Name="ShieldCheck" Size="18" Class="text-success shrink-0"/>
        <Label Text="{Res settings.tfa_on_success}" FontWeight="Medium" Overflow="Wrap" ForeColor="Success"/>
      </Stack>
      <!-- TODO(views-migrate): <BackupCodesPanel> is no .kbview element (./BackupCodesPanel#BackupCodesPanel) -->
      <ReactHost Component="{Binding BackupCodesPanel}" Props="{Binding backup_codes_panel_props}"/>
    </Panel>
    <Panel Visible="{Binding show_case_2}">
      <Label HtmlTag="H3" Text="{Res settings.tfa_title}" FontWeight="Medium" Overflow="Wrap" ForeColor="TextPrimary" Class="mb-3"/>
      <!-- TODO(views-migrate): elements held in an expression -->
      <ReactHost Component="{Binding Fragment}" Props="{Binding content_requirement_banner}"/>
      <Stack Direction="LeftToRight"
             Gap="12"
             CrossAlign="Center"
             BackColor="SuccessLight"
             Class="px-4 py-3 rounded-lg border border-success mb-4">
        <Icon Name="ShieldCheck" Size="18" Class="text-success shrink-0"/>
        <Panel>
          <Label Text="{Res settings.tfa_on}" FontWeight="Medium" Overflow="Wrap" ForeColor="Success"/>
          <Label Text="{Res settings.tfa_on_desc}" Role="Meta" Overflow="Wrap" Class="text-success/80"/>
        </Panel>
      </Stack>
      <Panel Class="mb-6">
        <BackupCodesSection/>
      </Panel>
      <Button Variant="Danger"
              Size="Sm"
              IconSize="14"
              Icon="ShieldOff"
              Text="{Res settings.tfa_disable_btn}"
              Visible="{Binding show_show_disable_form}"
              OnClick="button_click"/>
      <Panel HtmlTag="Form" Visible="{Binding show_not_show_disable_form}" Class="space-y-3 max-w-xs" OnSubmit="panel_submit">
        <Label Text="{Res settings.tfa_disable_confirm}" Overflow="Wrap" ForeColor="TextSecondary"/>
        <!-- TODO(views-migrate): <TextField> inputMode, autoFocus: no .kbview property -->
        <ReactHost Component="{Binding Part1}" Props="{Binding part1_props}"/>
        <Label Text="{Binding disableError}" Role="Meta" Overflow="Wrap" ForeColor="Danger" Visible="{Binding show_disable_error}"/>
        <Stack Direction="LeftToRight">
          <Button ButtonType="Submit"
                  Variant="Danger"
                  Size="Sm"
                  Enabled="{Binding enabled_unless_disable_code}"
                  Text="{Res settings.tfa_disable}"/>
          <Button Variant="Secondary" Size="Sm" Text="{Res common.cancel}" OnClick="button_click2"/>
        </Stack>
      </Panel>
    </Panel>
    <Panel Visible="{Binding show_case_3}">
      <Label HtmlTag="H3" Text="{Res settings.tfa_title}" FontWeight="Medium" Overflow="Wrap" ForeColor="TextPrimary" Class="mb-3"/>
      <Stack Direction="LeftToRight" Gap="12" CrossAlign="Center" BackColor="SuccessLight" Class="px-4 py-3 rounded-lg border border-success">
        <Icon Name="ShieldCheck" Size="18" Class="text-success shrink-0"/>
        <Label Text="{Res settings.tfa_on_success}" FontWeight="Medium" Overflow="Wrap" ForeColor="Success"/>
      </Stack>
    </Panel>
    <Panel Visible="{Binding show_case_4}">
      <Label HtmlTag="H3" Text="{Res settings.tfa_title}" FontWeight="Medium" Overflow="Wrap" ForeColor="TextPrimary" Class="mb-3"/>
      <Panel Class="space-y-4 max-w-sm">
        <Label Text="{Res settings.tfa_scan_desc}" Overflow="Wrap" ForeColor="TextSecondary"/>
        <Stack Direction="LeftToRight" Gap="0" Justify="Center" Class="p-4 bg-white border border-border rounded-lg w-fit">
          <!-- TODO(views-migrate): <QRCode> is no .kbview element (a local or dynamic component) -->
          <ReactHost Component="{Binding Part2}" Props="{Binding part2_props}"/>
        </Stack>
        <!-- TODO(views-migrate): <details> has no .kbview element yet -->
        <ReactHost Component="{Binding Part3}" Props="{Binding part3_props}"/>
        <Label Text="{Res settings.tfa_then_enter}" Overflow="Wrap" ForeColor="TextSecondary" Class="pt-1"/>
        <Panel HtmlTag="Form" Class="space-y-3" OnSubmit="panel_submit2">
          <!-- TODO(views-migrate): <TextField> inputMode, autoFocus: no .kbview property -->
          <ReactHost Component="{Binding Part4}" Props="{Binding part4_props}"/>
          <Label Text="{Binding error}" Role="Meta" Overflow="Wrap" ForeColor="Danger" Visible="{Binding show_error}"/>
          <Stack Direction="LeftToRight">
            <Button ButtonType="Submit" Enabled="{Binding enabled_unless_code}" Text="{Res settings.tfa_enable}"/>
            <Button Variant="Secondary" Text="{Res common.cancel}" OnClick="button_click3"/>
          </Stack>
        </Panel>
      </Panel>
    </Panel>
    <Panel Visible="{Binding show_main}">
      <Label HtmlTag="H3" Text="{Res settings.tfa_title}" FontWeight="Medium" Overflow="Wrap" ForeColor="TextPrimary" Class="mb-3"/>
      <!-- TODO(views-migrate): elements held in an expression -->
      <ReactHost Component="{Binding Fragment}" Props="{Binding content_requirement_banner2}"/>
      <Stack Direction="LeftToRight" Gap="12" CrossAlign="Start" BackColor="Surface1" Class="px-4 py-3 rounded-lg border border-border mb-4">
        <Icon Name="Shield" Size="18" Class="text-text-tertiary shrink-0 mt-0.5"/>
        <Panel>
          <Label Text="{Res settings.tfa_off}" FontWeight="Medium" Overflow="Wrap" ForeColor="TextPrimary"/>
          <Label Text="{Res settings.tfa_off_desc}" Role="Meta" Overflow="Wrap" ForeColor="TextSecondary" Class="mt-0.5"/>
        </Panel>
      </Stack>
      <Label Text="{Binding error}" Overflow="Wrap" ForeColor="Danger" Visible="{Binding show_error2}" Class="mb-3"/>
      <Button IconSize="15" Icon="ShieldCheck" Text="{Res settings.tfa_enable_btn}" OnClick="startSetup"/>
    </Panel>
  </Panel>
</UserControl>
