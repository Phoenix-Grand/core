<!-- NotificationsTab - converted from NotificationsTab.tsx by @kubuno/views-migrate (partial: see the TODO comments and the report). -->
<UserControl>
  <Panel Class="max-w-3xl space-y-8">
    <Panel HtmlTag="Section">
      <Label HtmlTag="H2"
             Text="{Res settings.notif_title}"
             FontWeight="SemiBold"
             Overflow="Wrap"
             ForeColor="TextPrimary"
             Class="text-base mb-3"/>
      <Label HtmlTag="Label" Text="{Res settings.notif_email_reminder}" Overflow="Wrap" ForeColor="TextSecondary" Class="block mb-1.5"/>
      <Dropdown SelectedValue="{Binding n.emailReminder}"
                ItemsSource="{Binding items_source}"
                OnSelectedValueChanged="dropdown_selected_value_changed"/>
      <Panel HtmlTag="Label" Class="flex items-center gap-2 mt-3 cursor-pointer select-none">
        <!-- TODO(views-migrate): <NotifCheck> is no .kbview element (a local or dynamic component) -->
        <ReactHost Component="{Binding NotifCheck}" Props="{Binding notif_check_props}"/>
        <Label HtmlTag="Span" Text="{Res settings.notif_sound}" Overflow="Wrap" ForeColor="TextPrimary"/>
      </Panel>
      <Panel HtmlTag="Label" Class="flex items-center gap-2 mt-2 cursor-pointer select-none">
        <!-- TODO(views-migrate): <NotifCheck> is no .kbview element (a local or dynamic component) -->
        <ReactHost Component="{Binding NotifCheck}" Props="{Binding notif_check_props2}"/>
        <Label HtmlTag="Span" Text="{Res settings.notif_sound_call}" Overflow="Wrap" ForeColor="TextPrimary"/>
      </Panel>
    </Panel>
    <Panel HtmlTag="Section">
      <Label HtmlTag="H2"
             Text="{Res settings.notif_activity}"
             FontWeight="SemiBold"
             Overflow="Wrap"
             ForeColor="TextPrimary"
             Class="text-base mb-1"/>
      <Label Text="{Res settings.notif_activity_desc}" Overflow="Wrap" ForeColor="TextTertiary" Class="mb-5"/>
      <Panel Class="space-y-7">
        <Repeater ItemKey="key" ItemsSource="{Binding rows_groups}">
          <Panel>
            <Stack Direction="LeftToRight" Gap="0" CrossAlign="Center" Class="border-b-2 border-border pb-2 mb-1">
              <Label HtmlTag="Span" Text="{Binding g.title}" FontWeight="Bold" Overflow="Wrap" ForeColor="TextPrimary" Class="flex-1"/>
              <Label HtmlTag="Span"
                     Text="{Res settings.notif_col_email}"
                     Role="Meta"
                     FontWeight="Medium"
                     TextAlign="TopCenter"
                     Overflow="Wrap"
                     ForeColor="TextTertiary"
                     Class="w-16"/>
              <Label HtmlTag="Span"
                     Text="{Res settings.notif_col_push}"
                     Role="Meta"
                     FontWeight="Medium"
                     TextAlign="TopCenter"
                     Overflow="Wrap"
                     ForeColor="TextTertiary"
                     Class="w-16"/>
            </Stack>
            <!-- TODO(views-migrate): a list inside a list (nested Repeater) -->
            <ReactHost Component="{Binding Part1}" Props="{Binding part1_props}"/>
          </Panel>
        </Repeater>
      </Panel>
      <Stack Direction="LeftToRight" Gap="12" CrossAlign="Center" Class="mt-6">
        <Label HtmlTag="Label" Text="{Res settings.notif_email_freq}" Overflow="Wrap" ForeColor="TextSecondary"/>
        <Dropdown SelectedValue="{Binding n.emailFrequency}"
                  ItemsSource="{Binding items_source2}"
                  OnSelectedValueChanged="dropdown_selected_value_changed2"/>
      </Stack>
    </Panel>
    <Panel HtmlTag="Section">
      <Label HtmlTag="H2"
             Text="{Res settings.notif_digest_title}"
             FontWeight="SemiBold"
             Overflow="Wrap"
             ForeColor="TextPrimary"
             Class="text-base mb-3"/>
      <Panel HtmlTag="Label" Class="flex items-center gap-2 cursor-pointer select-none">
        <!-- TODO(views-migrate): <NotifCheck> is no .kbview element (a local or dynamic component) -->
        <ReactHost Component="{Binding NotifCheck}" Props="{Binding notif_check_props3}"/>
        <Label HtmlTag="Span" Text="{Res settings.notif_digest_on}" Overflow="Wrap" ForeColor="TextPrimary"/>
      </Panel>
    </Panel>
    <Button Loading="{Binding busy}" Text="{Binding button_text}" OnClick="save"/>
  </Panel>
</UserControl>
