<!-- MyDataTab - converted from MyDataTab.tsx by @kubuno/views-migrate (partial: see the TODO comments and the report). -->
<UserControl>
  <Panel Class="contents">
    <Stack Direction="LeftToRight" Gap="0" Justify="Center" Visible="{Binding show_case_1}" Class="py-10">
      <Spinner/>
    </Stack>
    <!-- TODO(views-migrate): <Callout> icon: a value the property converts (null-when-false) -->
    <ReactHost Component="{Binding Part1}" Props="{Binding part1_props}" Visible="{Binding show_case_2}"/>
    <Panel Visible="{Binding show_main}" Class="space-y-5">
      <Panel>
        <Label HtmlTag="H2"
               Text="{Res settings.mde_title}"
               FontWeight="Medium"
               Overflow="Wrap"
               ForeColor="TextPrimary"
               InheritFontSize="true"
               Class="[font-size:var(--kb-text-heading)]"/>
        <Label Text="{Res settings.mde_intro}"
               Overflow="Wrap"
               ForeColor="TextSecondary"
               InheritFontSize="true"
               Class="mt-1 [font-size:var(--kb-text-body)]"/>
      </Panel>
      <!-- TODO(views-migrate): <Stepper> steps: no .kbview property -->
      <ReactHost Component="{Binding Part2}" Props="{Binding part2_props}"/>
      <Stack Direction="LeftToRight" CrossAlign="Center" WrapContents="true" Visible="{Binding show_stepper_id_download}">
        <Button Variant="Secondary" Text="{Res settings.mde_back}" Visible="{Binding show_stepper_id_options}" OnClick="button_click"/>
        <Button Text="{Res settings.mde_continue}" Visible="{Binding show_stepper_id_services}" OnClick="button_click2"/>
        <Button Loading="{Binding request.isPending}"
                Enabled="{Binding enabled_unless_data_active}"
                Text="{Res settings.mde_submit}"
                Visible="{Binding show_not_stepper_id_services}"
                OnClick="submit"/>
        <Label HtmlTag="Span"
               Text="{Res settings.mde_one_at_a_time}"
               Overflow="Wrap"
               ForeColor="TextSecondary"
               InheritFontSize="true"
               Visible="{Binding show_data_active_stepper}"
               Class="[font-size:var(--kb-text-meta)]"/>
      </Stack>
    </Panel>
  </Panel>
</UserControl>
