<!-- MobileSettingsIndex - converted from MobileSettingsIndex.tsx by @kubuno/views-migrate (partial: see the TODO comments and the report). -->
<UserControl>
  <Panel Class="pb-2">
    <Label HtmlTag="H1" Text="{Res settings.page_title}" FontWeight="Medium" Overflow="Wrap" ForeColor="TextPrimary" Class="text-xl px-1 mb-3"/>
    <Panel Class="divide-y divide-border rounded-xl border border-border overflow-hidden bg-white">
      <!-- TODO(views-migrate): a list callback destructuring its item -->
      <ReactHost Component="{Binding Part1}" Props="{Binding part1_props}"/>
    </Panel>
    <Panel Class="mt-4">
      <!-- TODO(views-migrate): <Slot> is no .kbview element (../slots/SlotRegistry#Slot) -->
      <ReactHost Component="{Binding Slot}" Props="{Binding slot_props}"/>
    </Panel>
  </Panel>
</UserControl>
