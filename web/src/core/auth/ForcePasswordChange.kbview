<!-- ForcePasswordChange - converted from ForcePasswordChange.tsx by @kubuno/views-migrate (partial: see the TODO comments and the report). -->
<Stack Direction="LeftToRight" Gap="0" CrossAlign="Center" Justify="Center" BackColor="Surface1" Class="min-h-screen p-8">
  <Panel Class="w-full max-w-md bg-white rounded-xl shadow-sm border border-border p-8">
    <Stack Direction="LeftToRight" CrossAlign="Center" Class="mb-6">
      <!-- TODO(views-migrate): <InstanceLogo> is no .kbview element (../shell/InstanceLogo#InstanceLogo) -->
      <ReactHost Component="{Binding InstanceLogo}" Props="{Binding instance_logo_props}"/>
      <Label HtmlTag="Span" Text="Kubuno" FontWeight="SemiBold" Overflow="Wrap" ForeColor="TextPrimary" Class="text-xl"/>
    </Stack>
    <Label HtmlTag="H1" Text="{Res forcepw.title}" FontWeight="Medium" Overflow="Wrap" ForeColor="TextPrimary" Class="text-xl mb-1"/>
    <Label Text="{Res forcepw.subtitle}" Overflow="Wrap" ForeColor="TextSecondary" Class="mb-4"/>
    <Stack Direction="LeftToRight"
           CrossAlign="Start"
           ForeColor="TextPrimary"
           BackColor="WarningLight"
           Class="text-sm px-3 py-2 rounded-md mb-6">
      <Icon Name="ShieldAlert" Size="16" Class="shrink-0 mt-0.5 text-warning"/>
      <Label HtmlTag="Span" Text="{Res forcepw.warning}" Overflow="Wrap" InheritFontSize="true"/>
    </Stack>
    <Panel HtmlTag="Form" Class="space-y-4" OnSubmit="panel_submit">
      <!-- TODO(views-migrate): <TextField> autoFocus: no .kbview property -->
      <ReactHost Component="{Binding Part1}" Props="{Binding part1_props}"/>
      <Panel Class="relative">
        <!-- TODO(views-migrate): <TextField> minLength: no .kbview property -->
        <ReactHost Component="{Binding Part2}" Props="{Binding part2_props}"/>
        <Panel AccessibleRole="PushButton"
               AutoSize="true"
               AccessibleName="{Res forcepw.toggle_visibility}"
               Class="absolute right-3 bottom-0 h-9 flex items-center text-text-tertiary hover:text-text-secondary"
               OnClick="panel_click">
          <Icon Name="EyeOff" Size="16" Visible="{Binding showPassword}"/>
          <Icon Name="Eye" Size="16" Visible="{Binding show_not_show_password}"/>
        </Panel>
        <Panel Visible="{Binding show_form_next}" Class="mt-1.5">
          <Stack Direction="LeftToRight" Gap="4" Class="mb-1">
            <Repeater ItemKey="key" ItemsSource="{Binding rows_items}">
              <!-- TODO(views-migrate): <div> with a computed style -->
              <ReactHost Component="{Binding Part3}" Props="{Binding part3_props}"/>
            </Repeater>
          </Stack>
          <!-- TODO(views-migrate): <span> with a computed style -->
          <ReactHost Component="{Binding Part4}" Props="{Binding part4_props}"/>
        </Panel>
      </Panel>
      <TextField Label="{Res forcepw.confirm}"
                 InputType="Password"
                 Text="{Binding form.confirm}"
                 Required="true"
                 AutoComplete="new-password"
                 Placeholder="••••••••"
                 OnTextChanged="text_field_text_changed"/>
      <Label HtmlTag="Div"
             Text="{Binding error}"
             Overflow="Wrap"
             ForeColor="Danger"
             BackColor="DangerLight"
             Visible="{Binding show_error}"
             Class="px-3 py-2 rounded-md"/>
      <Panel Class="grid grid-cols-2 gap-3 pt-1">
        <Button Variant="Secondary" Text="{Res forcepw.logout}" OnClick="button_click"/>
        <Button ButtonType="Submit" Loading="{Binding isLoading}" Text="{Res forcepw.submit}"/>
      </Panel>
    </Panel>
  </Panel>
</Stack>
