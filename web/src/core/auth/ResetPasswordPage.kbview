<!-- ResetPasswordPage - converted from ResetPasswordPage.tsx by @kubuno/views-migrate (partial: see the TODO comments and the report). -->
<Stack Direction="LeftToRight" Gap="0" CrossAlign="Center" Justify="Center" BackColor="Surface1" Class="min-h-screen p-8">
  <Panel BackColor="Surface" Class="w-full max-w-md rounded-xl shadow-sm border border-border p-8">
    <Stack Direction="LeftToRight" CrossAlign="Center" Class="mb-6">
      <!-- TODO(views-migrate): <InstanceLogo> is no .kbview element (../shell/InstanceLogo#InstanceLogo) -->
      <ReactHost Component="{Binding InstanceLogo}" Props="{Binding instance_logo_props}"/>
      <Label HtmlTag="Span" Text="Kubuno" FontWeight="SemiBold" Overflow="Wrap" ForeColor="TextPrimary" Class="text-xl"/>
    </Stack>
    <Stack Direction="LeftToRight" CrossAlign="Center" ForeColor="Success" Visible="{Binding done}" Class="mb-4">
      <Icon Name="CheckCircle2"/>
      <Label HtmlTag="H1" Text="{Res resetpw.done_title}" FontWeight="Medium" Overflow="Wrap" ForeColor="TextPrimary" Class="text-xl"/>
    </Stack>
    <Label Text="{Res resetpw.done_body}" Overflow="Wrap" ForeColor="TextSecondary" Visible="{Binding done}" Class="mb-6"/>
    <Panel Href="/login" Visible="{Binding done}" OnClick="panel_click">
      <Button Text="{Res resetpw.back_login}" Class="w-full"/>
    </Panel>
    <Label HtmlTag="H1"
           Text="{Res resetpw.title}"
           FontWeight="Medium"
           Overflow="Wrap"
           ForeColor="TextPrimary"
           Visible="{Binding visible}"
           Class="text-xl mb-3"/>
    <Callout Variant="Warning" Body="{Res resetpw.no_token}" Visible="{Binding visible}" Class="mb-6"/>
    <Panel Href="/forgot-password" Visible="{Binding visible}" OnClick="panel_click2">
      <Button Variant="Secondary" Text="{Res resetpw.back_login}" Class="w-full"/>
    </Panel>
    <Label HtmlTag="H1"
           Text="{Res resetpw.title}"
           FontWeight="Medium"
           Overflow="Wrap"
           ForeColor="TextPrimary"
           Visible="{Binding visible2}"
           Class="text-xl mb-1"/>
    <Label Text="{Res resetpw.intro}" Overflow="Wrap" ForeColor="TextSecondary" Visible="{Binding visible2}" Class="mb-6"/>
    <Panel HtmlTag="Form" Visible="{Binding visible2}" Class="space-y-4" OnSubmit="panel_submit">
      <Panel Class="relative">
        <!-- TODO(views-migrate): <TextField> minLength, autoFocus: no .kbview property -->
        <ReactHost Component="{Binding Part1}" Props="{Binding part1_props}"/>
        <Panel AccessibleRole="PushButton"
               AutoSize="true"
               AccessibleName="{Res resetpw.toggle_visibility}"
               Class="absolute right-3 bottom-0 h-9 flex items-center text-text-tertiary hover:text-text-secondary"
               OnClick="panel_click3">
          <Icon Name="EyeOff" Size="16" Visible="{Binding showPassword}"/>
          <Icon Name="Eye" Size="16" Visible="{Binding show_not_show_password}"/>
        </Panel>
        <Panel Visible="{Binding show_form_next}" Class="mt-1.5">
          <Stack Direction="LeftToRight" Gap="4" Class="mb-1">
            <Repeater ItemKey="key" ItemsSource="{Binding rows_items}">
              <!-- TODO(views-migrate): <div> with a computed style -->
              <ReactHost Component="{Binding Part2}" Props="{Binding part2_props}"/>
            </Repeater>
          </Stack>
          <!-- TODO(views-migrate): <span> with a computed style -->
          <ReactHost Component="{Binding Part3}" Props="{Binding part3_props}"/>
        </Panel>
      </Panel>
      <TextField Label="{Res resetpw.confirm}"
                 InputType="Password"
                 Text="{Binding form.confirm}"
                 Required="true"
                 AutoComplete="new-password"
                 Placeholder="••••••••"
                 OnTextChanged="text_field_text_changed"/>
      <Callout Variant="Danger" Body="{Binding error}" Visible="{Binding show_error}"/>
      <Button ButtonType="Submit" Loading="{Binding isLoading}" Text="{Res resetpw.submit}" Class="w-full"/>
      <LinkLabel Href="/login"
                 Text="{Res resetpw.back_login}"
                 ForeColor="Primary"
                 Class="block hover:underline underline-offset-2"
                 OnClick="link_label_click"/>
    </Panel>
  </Panel>
</Stack>
