{
  "name": "@kubuno/ui",
  "version": "0.1.17",
  "description": "Kubuno shared UI primitives (@ui) — pure, framework-level visual components used by the host and every module.",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/kubuno/core/tree/main/web/packages/ui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubuno/core.git",
    "directory": "web/packages/ui"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "types",
    "kbview-registry.web.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/index.js"
    },
