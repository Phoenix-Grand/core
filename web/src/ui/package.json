      "types": "./types/*.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "lucide-react": "^1.17.0",
    "clsx": "^2.0.0",
    "tailwind-merge": "^3.0.0",
    "date-fns": "^3.0.0 || ^4.0.0",
    "i18next": "^26.0.0",
    "react-i18next": "^17.0.0",
    "zustand": "^5.0.0"
  }
}
