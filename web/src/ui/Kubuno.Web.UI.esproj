<Project Sdk="Microsoft.VisualStudio.JavaScript.Sdk/1.0.6887863">
  <!-- npm/Vite through the Kubuno tooling (docs/WEB.md, "Frontends"): Windows native packages when node_modules
       was installed by Linux, Node.js from Visual Studio when none is on PATH, no npm install over a foreign tree. -->
  <Sdk Name="Kubuno.Web.Sdk" Version="1.0.1" />

  <!-- Generated by "Kubuno Core Web: Generate Solution" (docs/WEB.md). This file is yours: never overwritten by a later run. -->
  <PropertyGroup>
    <KubunoWebRole>Package</KubunoWebRole>
    <!-- @kubuno/ui is built from the host app's sources (core/frontend/packages/build.sh):
         the declarations of frontend/src, then its type tree and the ESM library, in obj\package. The committed types/ and dist/ are regenerated by build.sh; publishing stays a user action. -->
    <KubunoPackageId>ui</KubunoPackageId>
    <KubunoNodeModulesDirectory>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..'))\</KubunoNodeModulesDirectory>
  </PropertyGroup>

  <!-- The package's sources, which live in the host app's tree: shown here (and hidden from the app project). -->
  <ItemGroup>
    <None Include="..\..\src\ui\**\*" Link="src\ui\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
