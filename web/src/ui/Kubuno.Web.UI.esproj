<Project Sdk="Microsoft.VisualStudio.JavaScript.Sdk/1.0.6887863">
  <!-- npm/Vite through the Kubuno tooling (docs/WEB.md, "Frontends"): Windows native packages when node_modules
       was installed by Linux, Node.js from Visual Studio when none is on PATH, no npm install over a foreign tree. -->
  <Sdk Name="Kubuno.Web.Sdk" Version="1.0.1" />

  <!-- Generated by "Kubuno Web: Generate Solution" (docs/WEB.md). This file is yours: never overwritten by a later run. -->
  <PropertyGroup>
    <KubunoWebRole>Package</KubunoWebRole>
    <!-- @kubuno/ui is CO-LOCATED with its sources (this folder = disk, no linked items). It is a real ESM library
         built from these sources (web/packages/build.sh, vite.config.ts); the generated type tree (types/) and the
         ESM bundle (dist/) are regenerated here and gitignored, never committed. The host build resolves "@ui" to the
         source index.ts through the `kubuno-source` export condition (web/vite.config.ts), not to dist/. Publishing
         stays a user action. node_modules is the host app's (two levels up). -->
    <KubunoPackageId>ui</KubunoPackageId>
    <KubunoNodeModulesDirectory>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..'))\</KubunoNodeModulesDirectory>
    <!-- Generated publish artefacts are not sources: keep them out of Solution Explorer (obj\ already is). -->
    <DefaultItemExcludes>$(DefaultItemExcludes);types\**;dist\**;*.tgz</DefaultItemExcludes>
  </PropertyGroup>

</Project>
