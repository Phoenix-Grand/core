<Project Sdk="Microsoft.VisualStudio.JavaScript.Sdk/1.0.6887863">
  <!-- npm/Vite through the Kubuno tooling (docs/WEB.md, "Frontends"): Windows native packages when node_modules
       was installed by Linux, Node.js from Visual Studio when none is on PATH, no npm install over a foreign tree. -->
  <Sdk Name="Kubuno.Web.Sdk" Version="1.0.1" />

  <!-- Generated by "Kubuno Core Web: Generate Solution" (docs/WEB.md). This file is yours: never overwritten by a later run. -->
  <PropertyGroup>
    <KubunoWebRole>Package</KubunoWebRole>
    <!-- @kubuno/sdk is CO-LOCATED with its sources: package.json, index.js, README and CHANGELOG live in this folder
         (web/src/sdk), so the project tree matches disk (no linked items). It is still built from the host app's
         declarations (web/packages/build.sh / kubuno-packages.mjs); the generated type tree (types/) is regenerated
         and gitignored (never committed), excluded below. node_modules is the host app's (two levels up). -->
    <KubunoPackageId>sdk</KubunoPackageId>
    <KubunoNodeModulesDirectory>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..'))\</KubunoNodeModulesDirectory>
    <!-- Generated publish artefacts are not sources: keep them out of Solution Explorer (obj\ already is). -->
    <DefaultItemExcludes>$(DefaultItemExcludes);types\**;*.tgz</DefaultItemExcludes>
  </PropertyGroup>

</Project>
