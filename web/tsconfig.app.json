{
  "compilerOptions": {
    "target": "ES2022",
    "paths": {
      "@ui": ["./src/ui/index.ts"],
      "@ui/*": ["./src/ui/*"],
      "@kubuno/sdk": ["./src/sdk/index.ts"],
      "@kubuno/drive": ["./src/drive/index.ts"],
      "@kubuno/views": ["./src/views/index.ts"]
    },
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "customConditions": ["kubuno-source"],
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    // Generated `.kbview` / `.kbcontrol` declarations (`ViewBase`), written by the views compiler.
    "rootDirs": [".", ".kubuno/views"]
  },
  "include": ["src", ".kubuno/views"],
  "comment_exclude": "shims de build-only (ré-exports de paquets à `export =`) : compilés par rolldown, hors typecheck",
  "comment_exclude_generated": "Generated outputs of the co-located npm packages (gitignored, regenerated by packages/build.sh): type trees and the @kubuno/ui ESM bundle. Not sources — excluded so tsc does not re-check them (duplicate declarations).",
  "exclude": ["src/sdk/shared", "src/ui/types", "src/ui/dist", "src/sdk/types", "src/drive/types"]
}
